"tutorial1_1" = "Welcome to Sorobit. Tap the screen to move through the tutorial steps.";
"tutorial1_2" = "Tap the back button at the bottom left to go to the previous steps.";
"tutorial1_4" = "Now let's get started.";
"tutorial1_5" = "An abacus is a counting tool that uses beads to show numbers.";
"tutorial1_6" = "Each column stands for one place. The places get bigger from right to left.";
"tutorial1_7" = "Ones";
"tutorial1_8" = "Tens";
"tutorial1_9" = "Hundreds";
"tutorial1_10" = "Thousands";
"tutorial1_11" = "And ten thousands.";
"tutorial1_12" = "Each column has 5 beads.";
"tutorial1_13" = "The upper bead is worth five,";
"tutorial1_14" = "and each lower bead is worth one.";
"tutorial1_15" = "For example, this is how the number 1 looks on the abacus.";
"tutorial1_100" = "To show 2, we use 2 of the one-beads in the ones place.";
"tutorial1_101" = "For 3, we use 3,";
"tutorial1_102" = "and for 4, we use 4 one-beads.";
"tutorial1_103" = "The upper bead is worth five. So when we use it, it adds 5 to our number.";
"tutorial1_104" = "This is how 5 looks.";
"tutorial1_17" = "For 6, we use the upper bead and one lower bead.";
"tutorial1_105" = "This is 7.";
"tutorial1_106" = "This is 8,";
"tutorial1_107" = "and this is 9.";
"tutorial1_108" = "Let's practice with an example together.";
"tutorial1_109" = "Enter the number below on the abacus and tap the 'Check' button.";
"tutorial_ipucu_001" = "Use the rightmost one-bead.";
"tutorial1_110" = "Now enter this number and tap the 'Check' button.";
"tutorial_ipucu_002" = "Use 2 of the rightmost one-beads.";
"tutorial1_111" = "Enter this number.";
"tutorial_ipucu_003" = "Use the five-bead at the top right.";
"tutorial_ipucu_004" = "Use 1 five-bead and 1 one-bead.";
"tutorial1_113" = "Finally, enter this number.";
"tutorial_ipucu_005" = "Use 1 five-bead and 3 one-beads.";
"tutorial1_21" = "Now try to show the numbers I write on the board on the abacus.";
"tutorial3_100" = "In this lesson we'll look at two-digit numbers.";
"tutorial1_3" = "If you already know the topic, tap the Skip tutorial button at the bottom right to go straight to the test.";
"tutorial3_101" = "On the abacus, the places get bigger toward the left, just like in regular numbers.";
"tutorial3_102" = "To show 10, we use 1 one-bead in the tens place.";
"tutorial3_103" = "To show 20, we use 2 one-beads.";
"tutorial3_104" = "This is 30.";
"tutorial3_105" = "This is 40,";
"tutorial3_106" = "and when we want to show 50, we use the five-bead at the top.";
"tutorial3_107" = "This is 60.";
"tutorial3_108" = "This is 70,";
"tutorial3_109" = "this is 80,";
"tutorial3_110" = "and this is 90.";
"tutorial_ipucu_006" = "Use the beads in the 2nd column from the right. Add 1 five-bead and 2 one-beads.";
"tutorial3_111" = "Enter this number and tap the 'Check' button.";
"tutorial3_112" = "When writing numbers with more than one digit, always start from the largest place.";
"tutorial3_113" = "So when writing 12, we first write the 10 in the tens place.";
"tutorial3_114" = "Then we write the 2, and that's how 12 looks.";
"tutorial3_115" = "Let's write 24.";
"tutorial3_116" = "First I write the 20 in the tens place.";
"tutorial3_117" = "Then I write the 4 in the ones place, and we're done.";
"tutorial3_118" = "Let's write this number together.";
"tutorial3_119" = "First write the 30 in the tens place and tap the 'Check' button.";
"tutorial_ipucu_007" = "Use the beads in the 2nd column from the right. Add 3 one-beads.";
"tutorial3_120" = "Then write the 2 in the ones place and tap the 'Check' button.";
"tutorial_ipucu_008" = "Use the beads in the rightmost column. Add 2 one-beads.";
"tutorial3_121" = "When writing 78, we also start from the largest place.";
"tutorial3_122" = "First I write 70.";
"tutorial3_123" = "Then I write 8.";
"tutorial3_124" = "Finally, let's write this number together and then go to the test.";
"tutorial3_125" = "First write the tens digit and tap the 'Check' button.";
"tutorial_ipucu_009" = "Use the beads in the 2nd column from the right. Add 1 five-bead and 4 one-beads.";
"tutorial3_126" = "Then write the 4 in the ones place and tap the 'Check' button.";
"tutorial_ipucu_010" = "Use the beads in the rightmost column. Add 4 one-beads.";
"tutorial3_127" = "You learned that really fast. Now it's test time.";
"tutorial4_100" = "In this lesson we'll look at 3-, 4- and 5-digit numbers.";
"tutorial4_101" = "When writing 3-digit numbers, we start from the largest place, just like with two-digit numbers.";
"tutorial4_102" = "For example, when writing this number...";
"tutorial4_103" = "First I write the hundreds digit in the hundreds place on the abacus.";
"tutorial4_104" = "Then the tens digit,";
"tutorial4_105" = "and finally the ones digit.";
