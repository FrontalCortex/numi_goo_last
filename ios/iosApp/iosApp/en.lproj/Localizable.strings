"tutorial3_1" = "In this lesson you'll learn small friends addition, the first lesson on adding with rules.";
"tutorial3000_1" = "We use small friends when we can't add a number directly.";
"tutorial3000_2" = "For example, in this problem I enter 4 on the abacus.";
"tutorial3000_3" = "When I want to add 1, I can't add it directly. There's no lower bead left to add.";
"tutorial3000_4" = "That's when we use the small friends rule.";
"tutorial3_2" = "In the small friends rule, each number we add has a friend that makes 5 with it.";
"tutorial3_3" = "1's friend is 4.";
"tutorial3_4" = "2's friend is 3,";
"tutorial3_5" = "3's friend is 2,";
"tutorial3_6" = "and 4's friend is 1.";
"tutorial3000_5" = "When we can't add a number, we use this rule like this: ‘add 5, take away the friend’.";
"tutorial3_7" = "For example, let's try this problem.";
"tutorial3_8" = "First we enter the first number on the abacus.";
"tutorial3_9" = "Then we'll add the second number.";
"tutorial3_10" = "But we can't add 1 directly.";
"tutorial3_11" = "So here we'll use the small friends rule.";
"tutorial3_13" = "Add 5.";
"tutorial3_14" = "Take away its friend, 4.";
"tutorial3_15" = "The answer is 5.";
"tutorial3_17" = "First we enter 4 on the abacus.";
"tutorial3_18" = "Then we'll add 2. But we can't add 2 directly.";
"tutorial3_19" = "So we'll use the small friends rule.";
"tutorial3_20" = "2's friend is 3.";
"tutorial3_22" = "Take away its friend, 3.";
"tutorial3_23" = "The answer is 6.";
"tutorial3_25" = "First we enter 3 on the abacus.";
"tutorial3_26" = "Then we'll add 3. But we can't add 3 directly.";
"tutorial3_28" = "3's friend is 2.";
"tutorial3_30" = "Take away its friend, 2.";
"tutorial_ipucu_035" = "Add 5. Take away the friend.";
"tutorial_soru_001" = "What are the steps of the small friends rule?";
"tutorial_sik_004" = "Take away 5. Add the friend.";
"tutorial_sik_005" = "Add 5. Add the friend.";
"tutorial3_32" = "Finally, let's take this problem.";
"tutorial3_33" = "First we enter 2 on the abacus.";
"tutorial3_34" = "Then we'll add 4. But we can't add 4 directly.";
"tutorial3_37" = "Take away its friend, 1.";
"tutorial_ipucu_036" = "We look at the friend of the 2nd number, the one we can't add directly to the number on the abacus.";
"tutorial_soru_002" = "When using the small friends rule, whose friend do we look at?";
"tutorial_sik_006" = "The friend of the first number we entered on the abacus.";
"tutorial_sik_007" = "The friend of the number we can't add directly.";
"tutorial_sik_008" = "It doesn't matter. We pick one at random.";
