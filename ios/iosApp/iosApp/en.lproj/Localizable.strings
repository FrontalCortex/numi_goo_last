"tutorial_sik_002" = "The place doesn't matter. We can start anywhere.";
"tutorial_sik_003" = "From the largest place.";
"tutorial4_3005" = "First I write the ten thousands digit in the ten thousands place on the abacus.";
"tutorial4_2006" = "Then the thousands digit,";
