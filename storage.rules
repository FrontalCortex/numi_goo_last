rules_version = '2';

// GÜVENLİK MODELİ
//   Eskiden buradaki üç yolun üçünde de `allow read, write: if request.auth != null` vardı.
//   Yani ücretsiz açılan tek bir hesapla:
//     • Her öğrencinin soru ekran görüntüsü, ekran KAYDI (mikrofonla — çocuk sesi içerir) ve
//       sohbet medyası okunabiliyordu (dosya adları `{uid}_{zaman}` olduğu için tahmin edilebilir),
//     • Başkasının dosyasının ÜZERİNE yazılabiliyordu,
//     • Boyut/tip sınırı olmadığı için bucket'a sınırsız çöp yüklenebiliyordu.
//
//   Artık her yol sahibine (ve soru akışında onaylı öğretmene) kilitli, ayrıca boyut ve
//   içerik tipi doğrulanıyor.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Onaylı öğretmen mi? Firestore'a cross-service firestore.get() ile bakmak
    // güvenilir çalışmadı (öğretmenler kendi onayını doğrulatamıyordu); bunun yerine
    // Cloud Functions'ın (syncTeacherClaim) Firestore'daki teacherApproved alanıyla
    // senkron tuttuğu ID token custom claim'i okunuyor.
    function isTeacher() {
      return isSignedIn() && request.auth.token.teacherApproved == true;
    }

    // Dosya adı `{uid}_...` biçiminde mi — yani çağıranın kendi dosyası mı?
    // Firebase uid'leri yalnızca harf ve rakam içerdiği için düzenli ifade güvenli.
    function isOwnFile(fileName) {
      return isSignedIn() && fileName.matches(request.auth.uid + '_.*');
    }

    // Sorunun sahibi öğrenci veya onaylı öğretmen mi? Burada da Firestore'a
    // cross-service firestore.get() ile bakmak güvenilir çalışmadı (öğrenci kendi
    // sorusundaki öğretmen medyasını indiremiyordu); bunun yerine dosya QuestionUploadForegroundService
    // tarafından yüklenirken üzerine konan `studentUid` custom metadata'sı okunuyor.
    function ownsUploadedFile() {
      return isSignedIn() && request.resource.metadata.studentUid == request.auth.uid;
    }

    function ownsExistingFile() {
      return isSignedIn() && resource.metadata.studentUid == request.auth.uid;
    }

    // Soru ekran görüntüleri — CreateQuestionFragment `{uid}_{zaman}.jpg` olarak yükler.
    // Soru dokümanı henüz oluşmadan yüklendiği için yetki dosya adındaki uid'den geliyor.
    match /question_screenshots/{fileName} {
      allow read: if isOwnFile(fileName) || isTeacher();
      allow write: if isOwnFile(fileName)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Soru ekran kayıtları — `{uid}_{zaman}.mp4`.
    // Süre sınırı 180 sn (öğretmen), 4 Mbps video + 128 kbps ses → en fazla ~93 MB;
    // 150 MB rahat bir üst sınır.
    match /question_videos/{fileName} {
      allow read: if isOwnFile(fileName) || isTeacher();
      allow write: if isOwnFile(fileName)
        && request.resource.size < 150 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Soru mesaj medyası (görsel / ses / video). Yalnızca soruyu soran öğrenci ve
    // onaylı öğretmenler erişebilir; öğrenci kontrolü dosyanın studentUid metadata'sından.
    // Boyut sınırı question_videos ile aynı gerekçeyle 150 MB (bkz. yukarısı) — ekran
    // kaydı cevapları da bu yola yükleniyor.
    match /question_media/{questionId}/{fileName} {
      allow read: if isTeacher() || ownsExistingFile();
      allow write: if (isTeacher() || ownsUploadedFile())
        && request.resource.size < 150 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('audio/.*'));
    }

    // Tutorial sesleri (Remote Config'ten "soundUrl" ile referans verilir): statik eğitim
    // içeriği, hassas veri değil. Misafir kullanıcılar (ilk açılışta) kimliksiz olduğu için
    // okuma herkese açık olmalı. Yazma sadece Firebase Console/Admin SDK üzerinden yapılır.
    match /tutorial_audio/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Yukarıda tanımlanmayan her yol reddedilir.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
