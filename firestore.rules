rules_version = '2';
// Update account deletion rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: İstek atan kişinin öğretmen onaylı olup olmadığını kontrol eder
    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherApproved == true;
    }

    // Kullanıcılar: sadece giriş yapmış kullanıcılar okuyabilir; yazma/silme sadece kendi dokümanına
    match /users/{userId} {
      allow read: if request.auth != null; // Yalnızca giriş yapmış kullanıcılar okuyabilir (GDPR/KVKK koruması) 
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['keys', 'currency', 'role', 'teacherApproved', 'plan', 'userId', 'uid', 'email', 'createdAt'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) ||
        (isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'banned', 'restrictedUntil', 'restrictionReason', 'restrictionMessagePreview',
          'restrictionMessageType', 'restrictionMediaUrl', 'restrictionThumbnailUrl',
          'restrictedAt', 'restrictedByUid'
        ]))
      );
    }

    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null; // Giriş yapmış herkes istek okuyup yazabilir
    }

    // Kullanıcının kendi alt koleksiyonları (lessonProgress, missionProgress, dailyQuestion vb.)
    // sadece ilgili kullanıcı tarafından okunup yazılabilir.
    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rozet, Kupa Yolu ve Ders İlerlemesi verileri: giriş yapmış herkes okuyabilir (başkasının profilini görüntülemek için)
    match /users/{userId}/badgeProgress/{doc} {
      allow read: if request.auth != null;
    }
    match /users/{userId}/cupWayProgress/{doc} {
      allow read: if request.auth != null;
    }
    match /users/{userId}/cupHistory/{doc} {
      allow read: if request.auth != null;
    }
    match /users/{userId}/lessonProgress/{doc} {
      allow read: if request.auth != null;
    }
    // Ders ilerlemesi artık partId dokümanının altında items/{position} alt koleksiyonunda tutulur
    // (tek bir JSON-string yerine her item ayrı doküman). Görünürlük üstteki lessonProgress/{doc} ile aynı.
    match /users/{userId}/lessonProgress/{partId}/items/{itemId} {
      allow read: if request.auth != null;
    }
    match /users/{userId}/abacusCustomization/{doc} {
      allow read: if request.auth != null;
    }

    // Öğretmen davet kodları: kayıt sırasında doğrulama için okuma ve işaretleme için update açık.
    // Oluşturma sadece admin (Cloud Function) tarafından yapılır. Silme tamamen kapalı.
    match /teacherInvites/{code} {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    // Öğrenci doğrulama kodları: unauthenticated kullanıcılar OTP doğrulama için okuyup update edebilir
    match /studentVerificationCodes/{code} {
      allow read, write: if false; // Sadece Cloud Functions erişebilir
    }

    // Bekleyen kayıtlar (e-posta doğrulama): unauthenticated kullanıcılar kayıt için okuyup yazabilir
    match /pendingRegistrations/{docId} {
      allow write: if true; // Kayıt başlatılırken ve tekrar denendiğinde istemci yazabilsin
      allow read: if false; // Sadece Cloud Functions okuyabilir (şifre güvenliği)
    }

    // OTP rate limit ve yanlış deneme sayacı: sadece Cloud Functions (Admin SDK) yazar, istemci erişemez
    match /otpRateLimits/{docId} {
      allow read, write: if false;
    }
    match /otpWrongAttempts/{docId} {
      allow read, write: if false;
    }

    // Sorular: Sadece sorunun sahibi ve onaylı öğretmenler okuyup güncelleyebilir
    match /questions/{questionId} {
      // Okuma ve Güncelleme: Soruyu soran öğrenci VEYA öğretmen
      allow read, update: if request.auth != null && (resource.data.studentUid == request.auth.uid || isTeacher());
      // Oluşturma: Herkes
      allow create: if request.auth != null;
      // Silme: Sadece sorunun sahibi
      allow delete: if request.auth != null && resource.data.studentUid == request.auth.uid;
      
      // Mesajlar Alt Koleksiyonu
      match /messages/{messageId} {
        // Okuma, Yazma, Güncelleme: Ana sorunun sahibi öğrenci VEYA öğretmenler
        allow read, create, update: if request.auth != null && (
          get(/databases/$(database)/documents/questions/$(questionId)).data.studentUid == request.auth.uid || 
          isTeacher()
        );
        // Silme: SADECE mesajı bizzat gönderen kişi
        allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
      }
    }

    // Bildirilen mesajlar: giriş yapmış kullanıcı rapor ekleyebilir; kendi raporunu veya onaylı öğretmen tümünü okuyabilir/işleyebilir
    match /messageReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.reportedByUid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.reportedByUid == request.auth.uid ||
        isTeacher()
      );
      // Onaylı öğretmen: sadece pending -> dismissed/action_taken geçişi, sadece işlem alanlarını değiştirebilir.
      allow update: if request.auth != null && isTeacher()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['dismissed', 'action_taken']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'handledByUid', 'handledAt'])
        && request.resource.data.handledByUid == request.auth.uid;
      allow delete: if false;
    }

    // Tahta üst dokümanı (meta): sezon sonu CF sorgusu için partId / lessonIndex / season (+ isteğe bağlı titleUnit).
    // Not: [FieldValue.serverTimestamp] yazımında kurallar `updatedAt is timestamp` ile doğrulanamaz; yalnızca alanın varlığını şart koşuyoruz.
    match /lessonLeaderboards/{leaderboardId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.partId is number
        && request.resource.data.lessonIndex is number
        && request.resource.data.season is number
        && ('updatedAt' in request.resource.data)
        && (!('titleUnit' in request.resource.data)
            || (request.resource.data.titleUnit is string
                && request.resource.data.titleUnit.size() < 200));
      allow delete: if false;
    }

    // Ders liderlik tablosu girişleri: giriş yapmış herkes okur.
    // Yazma işlemleri YALNIZCA sunucu taraflı `submitLeaderboardScore` Cloud Function üzerinden yapılır.
    // (Admin SDK kuralları bypass ettiğinden direkt CF yazımı çalışır.)
    // İstemciden doğrudan yazma kapalıdır → cihaz saati manipülasyonuna karşı koruma.
    match /lessonLeaderboards/{leaderboardId}/entries/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anket panelleri (Ders sonu ve Tutorial sonu)
    match /questionPanel/{document=**} {
      // Güvenlik: Okuma ve silme yasak! Sadece yeni oy/cevap ekleme (create) ve sayacı artırma (update) serbest.
      allow create, update: if request.auth != null;
      allow read, delete: if false;
    }
    match /questionPanelTutorial/{document=**} {
      allow create, update: if request.auth != null;
      allow read, delete: if false;
    }

    // Geri bildirimler
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }
    match /ratingFeedback/{ratingId} {
      // Sadece kendi UID'si ile eşleşen dokümana yazabilir (Spam Koruması: 1 Kullanıcı = 1 Yorum)
      allow create, update: if request.auth != null && request.auth.uid == ratingId;
      allow read, delete: if false;
    }

    // Uygulama istatistikleri (Nereden duydunuz sayaçları)
    // Okuma kapalı → istemciler istatistik verisini göremez. Yazma sadece giriş yapmış kullanıcılara açık.
    match /appStatistics/{docId} {
      allow create, update: if request.auth != null;
      allow read, delete: if false;
    }

    // Günlük Soru Başarı Oranları
    match /successRate/{document=**} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Yukarıdakilerin dışındaki tüm path'ler reddedilir (ileride meetingRequests vb. eklenebilir)
    match /{document=**} {
      allow read, write: if false;
    }

    // Takip sistemi: takipçi alt koleksiyonu
    // Bir kullanıcıyı takip etmek = o kullanıcının followers/ koleksiyonuna kendi UID'ini yazma
    match /users/{targetUserId}/followers/{followerUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == followerUid;
    }

    // Takip sistemi: takip edilenler alt koleksiyonu
    // Birini takip etmek = kendi following/ koleksiyonuna hedef UID'i yazma
    match /users/{ownerUserId}/following/{followingUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == ownerUserId || request.auth.uid == followingUid);
    }
  }
}
