<?xml version="1.0" encoding="utf-8"?>
<!--
  Ders sonu ekranlarının Devam düğmesi (LessonResult, LessonResultFalse, ChestResult; eski düz renk #8CC63F).
  Duolingo tarzı göçen düğme: altta 4 dp koyu "dudak". Basılıyken dudak gizlenir; yüzün aşağı
  inmesini DepthPress yapar. Desen: bg_depth_tutorial_control.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8CC63F" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#62A12E" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8CC63F" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
