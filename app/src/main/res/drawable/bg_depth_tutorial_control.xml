<?xml version="1.0" encoding="utf-8"?>
<!--
  Öğretici: Kontrol Et ve Devam (eski renk lesson_completed).
  Duolingo tarzı göçen düğme: altta 4 dp koyu "dudak". Basılıyken dudak gizlenir; yüzün aşağı
  inmesini DepthPress yapar (görünümü 4 dp aşağı kaydırır). Desen: bg_hw_send.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8FD14F" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#62A12E" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8FD14F" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
