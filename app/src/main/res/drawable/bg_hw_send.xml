<?xml version="1.0" encoding="utf-8"?>
<!--
  Ödevi gönder: birincil düğme.
  Duolingo tarzı göçen düğme: altta 4 dp koyu "dudak". Basılıyken dudak gizlenir; yüzün aşağı
  inmesini DepthPress yapar (görünümü 4 dp aşağı kaydırır).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1CB0F6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1899D6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1CB0F6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
