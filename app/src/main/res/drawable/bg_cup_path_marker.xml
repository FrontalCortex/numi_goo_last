<?xml version="1.0" encoding="utf-8"?>
<!--
  "Şu an buradasın" etiketi: yolun üstünde duran, güncel kupa sayısını taşıyan hap.

  Ekranın üstündeki sayıyı tekrar etmiyor, YERİNİ gösteriyor: kullanıcı kaç kupası
  olduğunu değil, sıradaki sandığa ne kadar kaldığını merak ediyor ve bunu ancak yolun
  üstünde görünce anlıyor.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFB300" />
    <corners android:radius="12dp" />
    <stroke
        android:width="2dp"
        android:color="#141F23" />
</shape>
