<?xml version="1.0" encoding="utf-8"?>
<!--
  Sayıların göründüğü kart (eski kara tahta görseli yerine): ödev oynatıcısı, ders (AbacusFragment),
  kupa yolu (BlindingLessonFragment) ve abaküs pratiği. Ödev kartlarıyla (bg_depth_card) aynı dil, altta
  4 dp koyu "dudak". Basılmadığı için seçici yok.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#37464F" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bright_background_color" />
            <stroke android:width="2dp" android:color="#37464F" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
