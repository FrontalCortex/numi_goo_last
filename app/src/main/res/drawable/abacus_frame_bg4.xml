<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- Dış siyah sınır -->
    <path
        android:fillColor="#000000"
        android:pathData="M 100,0 L 900,0 A 100,100 0 0 1 1000,100 L 1000,900 A 100,100 0 0 1 900,1000 L 100,1000 A 100,100 0 0 1 0,900 L 0,100 A 100,100 0 0 1 100,0 Z" />

    <!-- Instagram Renk Geçişli Çerçeve (Kalınlık: 56 birim) -->
    <path
        android:pathData="M 100,14 L 900,14 A 86,86 0 0 1 986,100 L 986,900 A 86,86 0 0 1 900,986 L 100,986 A 86,86 0 0 1 14,900 L 14,100 A 86,86 0 0 1 100,14 Z">
