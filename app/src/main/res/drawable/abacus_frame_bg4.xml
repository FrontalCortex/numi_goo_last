    <!-- İç siyah sınır -->
    <path
        android:fillColor="#000000"
        android:pathData="M 100,70 L 900,70 A 30,30 0 0 1 930,100 L 930,900 A 30,30 0 0 1 900,930 L 100,930 A 30,30 0 0 1 70,900 L 70,100 A 30,30 0 0 1 100,70 Z" />

    <!-- İç arka plan -->
