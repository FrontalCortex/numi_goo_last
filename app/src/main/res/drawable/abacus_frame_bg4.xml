        android:fillColor="#212226"
        android:pathData="M 100,84 L 900,84 A 16,16 0 0 1 916,100 L 916,900 A 16,16 0 0 1 900,916 L 100,916 A 16,16 0 0 1 84,900 L 84,100 A 16,16 0 0 1 100,84 Z" />

