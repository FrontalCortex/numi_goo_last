            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="1000"
                android:endX="1000"
                android:endY="0">
                <item android:color="#FEDA77" android:offset="0.0" />
                <item android:color="#F58529" android:offset="0.25" />
                <item android:color="#DD2A7B" android:offset="0.5" />
                <item android:color="#8134AF" android:offset="0.75" />
                <item android:color="#515BD4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
