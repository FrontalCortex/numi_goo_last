<?xml version="1.0" encoding="utf-8"?>
<!--
  Takibi bırakma (X) butonunun arka planı.

  Takip etme (+) butonu dolu mavi (bg_add_friend_btn) çünkü davet eden bir eylem.
  Bu ise geri alan bir eylem: içi boş, ince çerçeveli ve sessiz duruyor ki listede
  "+" kadar dikkat çekmesin. Kırmızı da değil — takibi bırakmak yıkıcı bir işlem değil,
  istenince geri alınabiliyor.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="2dp"
        android:color="#37464F" />
    <corners android:radius="12dp" />
</shape>
