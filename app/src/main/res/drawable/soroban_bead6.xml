<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="92dp"
    android:viewportWidth="120"
    android:viewportHeight="72">

    <!-- Yumuşak Dış Gölge (Drop Shadow - Yüzeyden çıkık görünümü verir) -->
    <path
        android:pathData="M 40,16 L 88,16 A 24,24 0 0,1 112,40 A 24,24 0 0,1 88,64 L 40,64 A 24,24 0 0,1 16,40 A 24,24 0 0,1 40,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="64"
                android:centerY="40"
                android:gradientRadius="48">
                <item android:color="#4D000000" android:offset="0.4" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Kil / Mat Plastik Ana Zemin (Pastel Mint Yeşili) -->
    <path
        android:fillColor="#9AE2C6"
        android:pathData="M 36,12 L 84,12 A 24,24 0 0,1 108,36 A 24,24 0 0,1 84,60 L 36,60 A 24,24 0 0,1 12,36 A 24,24 0 0,1 36,12 Z" />

    <!-- Neumorphic Üst-Sol Işık (Inner Bevel Highlight) -->
    <!-- Işık sol üstten vuruyor, tepe kısmı aydınlanıyor -->
    <path
        android:pathData="M 36,12 L 84,12 A 24,24 0 0,1 108,36 A 24,24 0 0,1 84,60 L 36,60 A 24,24 0 0,1 12,36 A 24,24 0 0,1 36,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="12"
                android:endX="80"
                android:endY="60">
                <item android:color="#B3FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="0.5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neumorphic Alt-Sağ Gölge (Inner Bevel Shadow) -->
    <!-- Sol üstten vuran ışık sağ alt kısımda kendi gölgesini oluşturuyor -->
    <path
        android:pathData="M 36,12 L 84,12 A 24,24 0 0,1 108,36 A 24,24 0 0,1 84,60 L 36,60 A 24,24 0 0,1 12,36 A 24,24 0 0,1 36,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="20"
                android:endX="108"
                android:endY="60">
                <item android:color="#00000000" android:offset="0.3" />
                <item android:color="#66005533" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Yumuşak sınır çizgisi (Arka plana karışmaması için çok ince ve yumuşak hat) -->
    <path
        android:strokeWidth="1"
        android:strokeColor="#33000000"
        android:pathData="M 36,12 L 84,12 A 24,24 0 0,1 108,36 A 24,24 0 0,1 84,60 L 36,60 A 24,24 0 0,1 12,36 A 24,24 0 0,1 36,12 Z" />

</vector>
