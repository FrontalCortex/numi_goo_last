<?xml version="1.0" encoding="utf-8"?>
<!--
  Kupa yolunda "alınmayı bekleyen" sandığın arkasındaki halka.

  Yol boyunca bütün sandıklar aynı göründüğü için (hepsi sıradan sandık olarak başlıyor)
  kullanıcının hangisine dokunması gerektiği başka türlü anlaşılmıyordu. Halka yalnızca
  hazır sandıkta görünür.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#33FFB300" />
    <stroke
        android:width="3dp"
        android:color="#FFB300" />
</shape>
