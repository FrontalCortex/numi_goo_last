<?xml version="1.0" encoding="utf-8"?>
<!--
  Meydan okuma kartındaki ödül rozeti ("+500" + altın ikonu).

  Kartın kendi zemininden bir ton koyu: rozet kartın üstünde duran ayrı bir şey gibi
  görünsün, kartın bir parçası gibi değil.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#16252A" />
    <stroke
        android:width="1dp"
        android:color="#3A525B" />
    <corners android:radius="12dp" />
</shape>
