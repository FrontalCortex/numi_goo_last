<?xml version="1.0" encoding="utf-8"?>
<!--
  Ödev oynatıcısı: Başla / Kontrol. bg_depth_tutorial_control ile aynı göçen düğme (altta 4 dp dudak,
  göçmeyi DepthPress yapıyor), ek olarak pasif hali gri: sayılar akarken Kontrol basılamıyor.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#A6A6A6" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_disabled" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8FD14F" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#62A12E" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8FD14F" />
                    <corners android:radius="@dimen/tutorial_control_button_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
