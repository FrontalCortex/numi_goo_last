<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="92dp"
    android:viewportWidth="120"
    android:viewportHeight="72">

    <!-- Karanlık Zemin (Uzay Boşluğu Siyahı/Laciverti) -->
    <path
        android:fillColor="#05040A"
        android:pathData="M 36,0 L 84,0 A 36,36 0 0,1 120,36 A 36,36 0 0,1 84,72 L 36,72 A 36,36 0 0,1 0,36 A 36,36 0 0,1 36,0 Z" />

    <!-- Merkeze doğru Mor Neon Parlaması (Seçili olunca zayıflar) -->
    <path
        android:pathData="M 36,12 L 84,12 A 24,24 0 0,1 108,36 A 24,24 0 0,1 84,60 L 36,60 A 24,24 0 0,1 12,36 A 24,24 0 0,1 36,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60"
                android:centerY="36"
                android:gradientRadius="48">
                <item android:color="#1AB200FF" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dış Neon Çizgi (Seçili halde koyulaşmış neon) -->
    <path
        android:strokeWidth="3"
        android:pathData="M 36,12 L 84,12 A 24,24 0 0,1 108,36 A 24,24 0 0,1 84,60 L 36,60 A 24,24 0 0,1 12,36 A 24,24 0 0,1 36,12 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="60"
                android:endX="108"
                android:endY="12">
                <item android:color="#006666" android:offset="0.0" />
                <item android:color="#440066" android:offset="0.5" />
                <item android:color="#660033" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Merkez Enerji Çekirdeği (Yatay Çizgi - Kararmış) -->
    <path
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M 36,36 L 84,36">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="36"
                android:endX="84"
                android:endY="36">
                <item android:color="#006666" android:offset="0.0" />
                <item android:color="#660033" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cyberpunk Dijital Noktalar (Seçili) -->
    <path 
        android:strokeWidth="4" 
        android:strokeLineCap="round" 
        android:strokeColor="#006666" 
        android:pathData="M 22,36 L 24,36" />
        
    <path 
        android:strokeWidth="4" 
        android:strokeLineCap="round" 
        android:strokeColor="#660033" 
        android:pathData="M 96,36 L 98,36" />

</vector>
