<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar düzenleme ekranındaki seçenek kutusu: seçili olan alt bardaki seçim kutusuyla aynı çerçeveyi alır. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/bright_background_color" />
            <stroke android:width="2.5dp" android:color="@color/bottom_nav_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/bright_background_color" />
        </shape>
    </item>
</selector>
