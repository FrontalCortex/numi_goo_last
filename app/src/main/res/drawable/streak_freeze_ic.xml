<?xml version="1.0" encoding="utf-8"?>
<!--
  Seri dondurma: buz kalıbının içinde donmuş seri alevi.

  Alevin biçimi streak_flame_ic ile AYNI yol (yalnızca küçültülmüş ve buz mavisine
  boyanmış): çocuk üst bardaki alevi tanıyor, "bu o alevin donmuş hâli" diye okuması
  isteniyor. Ayrı bir kar tanesi çizilseydi seriyle bağı kurulmazdı.

  Mağaza kartında 64dp, satın alma animasyonunda 30dp çiziliyor; ikisinde de okunsun diye
  ince ayrıntı yok.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Buz kalıbı -->
    <path
        android:fillColor="#4FC3F7"
        android:fillAlpha="0.30"
        android:strokeColor="#81D4FA"
        android:strokeWidth="1.1"
        android:pathData="M6.5,2.5h11a4,4 0,0 1,4 4v11a4,4 0,0 1,-4 4h-11a4,4 0,0 1,-4 -4v-11a4,4 0,0 1,4 -4z" />

    <!-- Donmuş alev: streak_flame_ic'in iki katmanı, soğuk renklerle -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <path
            android:fillColor="#29B6F6"
            android:pathData="M12,2c0,0 1.5,3 3.2,5.2C17.2,9.8 18.5,11.7 18.5,14c0,3.6 -2.9,6.5 -6.5,6.5S5.5,17.6 5.5,14c0,-2.1 1,-3.8 2.3,-5.4C9.4,6.6 12,2 12,2z" />
        <path
            android:fillColor="#E1F5FE"
            android:pathData="M12,20c-1.9,0 -3.4,-1.5 -3.4,-3.4c0,-1.2 0.6,-2.1 1.3,-2.9c0.8,-0.9 1.5,-1.9 1.5,-3.1c0,0 2.1,1.9 2.1,3.8c0,0.7 -0.3,1.3 -0.3,1.3s0.9,-0.5 1.3,-1.5c0.6,0.9 0.9,1.7 0.9,2.4C15.4,18.5 13.9,20 12,20z" />
    </group>

    <!-- Buzun parlaması: sol üstte iki çizgi, sağ üstte küçük bir yıldız -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M5.2,7.4l2.2,-2.2" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M5.2,10.2l5,-5" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.2,5.1l0.55,1.25l1.25,0.55l-1.25,0.55l-0.55,1.25l-0.55,-1.25l-1.25,-0.55l1.25,-0.55z" />
</vector>
