<?xml version="1.0" encoding="utf-8"?>
<!--
  Sobi'nin testi panelinde seçili zorluk kartı: bg_hw_chip ile aynı dudaklı kart, kenarı ve dudağı mavi,
  yüzü hafif mavi. Basılıyken dudak gizlenir (DepthPress yüzü 4 dp aşağı indirir).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#16384A" />
                    <stroke android:width="2dp" android:color="#1CB0F6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1899D6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#16384A" />
                    <stroke android:width="2dp" android:color="#1CB0F6" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
