<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NumiGoo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="android:statusBarColor">@color/background_color</item>
    </style>

    <!--
      Manifest'te kullanılan tema: üst ve alt sistem çubuğu ekranın zemin rengiyle aynı.
      Alt çubuk eskiden message_topbar'dı (#111416, zeminden koyu): kendi rengini koddan
      vermeyen ekranlarda (giriş, kayıt, öğretmen girişi/OTP, e-posta doğrulama) telefonun
      tuşlarının olduğu şerit ekrandan kopuk duruyordu. Açık temadaki tanımla da artık aynı.
    -->
    <style name="Theme.NumiGoo" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@color/background_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/background_color</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textViewStyle">@style/Widget.NumiGoo.TextView</item>
        <item name="buttonStyle">@style/Widget.NumiGoo.Button</item>
    </style>
</resources>