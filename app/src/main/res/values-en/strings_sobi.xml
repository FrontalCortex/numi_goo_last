    <string name="review_intro_found">I found your mistake! %1$s\n\nNow let\'s solve this problem together step by step.</string>
    <string name="review_intro_unknown">Let\'s solve this problem together step by step and find where it went wrong.</string>
    <string name="review_step_write">First enter %1$d on the abacus, then tap \"Check\".</string>
    <string name="review_step_add">Add %2$d to the %1$s place.\n%3$s: %4$s.</string>
    <string name="review_step_sub">Take %2$d away from the %1$s place.\n%3$s: %4$s.</string>
    <string name="review_was_here">Careful! This is where you slipped a moment ago.</string>
    <string name="review_correct">Well done, that\'s right!</string>
    <string name="review_wrong">Let\'s look again. %1$s\n\nI moved the abacus back to the start of this step, try again. You can also tap \"Show me\".</string>
    <string name="review_found_now">There it is, the mistake is most likely here!</string>
    <string name="review_done">Great, we solved it together: %1$s = %2$d.</string>
    <string name="review_intro_sequence">You slipped in %1$d places in this sequence: %2$s. No need to redo the ones you got right; let\'s just solve these problems together.</string>
    <string name="review_mistake_add">Mistake %1$d: With %2$d on the abacus, adding %3$d you got %4$d; it should have been %5$d.</string>
    <string name="review_mistake_sub">Mistake %1$d: With %2$d on the abacus, taking away %3$d you got %4$d; it should have been %5$d.</string>
    <string name="review_mistake_write">Mistake %1$d: The first number was %2$d, but you entered %3$d on the abacus.</string>
    <string name="sobi_screen_lesson_step">Lesson step</string>
    <string name="sobi_screen_lesson_intro">We\'re at this part of the lesson right now:\n«%1$s»\n\nWhat\'s confusing you? Pick from below or write to me.</string>
    <string name="sobi_screen_lesson_op_intro">The lesson is explaining this problem: %1$s\n«%2$s»\n\nLet\'s do it step by step on the abacus together. If you want to ask something else, write below or tap ‹ to go back to the lesson step.</string>
    <string name="sobi_screen_lesson_op_done">Great, we did it together! You can solve another example or tap \"Back to lesson\".</string>
    <string name="sobi_screen_question_intro">We\'re on this question right now: «%1$s»\n\nLet\'s solve it together step by step. Tap the bubbles below whenever you get stuck.</string>
    <string name="sobi_screen_question_done">Great, we solved it together! Now tap \"Back to lesson\" and do the same thing on your own.</string>
    <string name="sobi_screen_example_intro">Example: %1$s. The first number is ready on the abacus; this problem uses %2$s. Let\'s do it together step by step.</string>
    <string name="sobi_screen_example_intro_direct">Example: %1$s. The first number is ready on the abacus; this problem doesn\'t need a rule. Let\'s do it together step by step.</string>
    <string name="sobi_screen_example_title">Example done</string>
    <string name="sobi_screen_example_done">Great, we solved the example: %1$s = %2$d. Tap \"Another example\" or go back to the lesson.</string>
    <string name="sobi_screen_example_done_ai">Great, %1$s = %2$d! Tap \"Next question\" and I\'ll pick one just for you.</string>
