<?xml version="1.0" encoding="utf-8"?>
<!--
  Sobi sekmesi (tablet): sohbet listesi solda kalıcı; çekmece yok, ☰ gizli (SobiChatFragment
  kök DrawerLayout değilse böyle davranıyor).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <include
        layout="@layout/sobi_chat_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#22888888" />

    <include
        layout="@layout/sobi_chat_main"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
