<?xml version="1.0" encoding="utf-8"?>
<!-- Ders kartına basınca hafif küçülme (genişlik tam ekran olduğu için dairedeki 0,80 fazla geliyordu) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:duration="150" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:duration="150" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:duration="250" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="scaleY" android:duration="250" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
</selector>
