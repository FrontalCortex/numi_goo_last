<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!--
      Adım göstergesi.

      Ekrandaki geri butonu kaldırıldı: kayıt akışında tek bir ileri yön var ve köşedeki
      ok kullanıcıyı "buradan çıkabilirim" diye düşündürüyordu. Geri gitmek hâlâ mümkün,
      telefonun kendi geri tuşuyla — o davranış UserInfoFragment'te zaten tanımlı.
    -->
    <ProgressBar
        android:id="@+id/userInfoProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:max="100"
        android:progress="50"
        android:progressBackgroundTint="#2E4149"
        android:progressTint="@color/dark_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Yaş Adımı Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/userInfoProgress">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kaç yaşındasın?"
            android:textColor="@color/dark_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="140dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_edit_profile_input"
            android:gravity="center"
            android:hint="Yaş"
            android:textColorHint="@color/dark_text_secondary"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Kaynak Adımı Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sourceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/userInfoProgress"
        app:layout_constraintBottom_toTopOf="@id/btnContinue">

        <TextView
            android:id="@+id/tvSourceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bizi nereden duydunuz?"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tvSourceTitle"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceFacebook"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Facebook"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceInstagram"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Instagram"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceYoutube"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Youtube"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceGoogle"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Google Araması"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceFriends"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Arkadaş/Aile"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceTiktok"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="TikTok"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceStore"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Uygulama Mağazası"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceOther"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Diğer"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      Seri hedefi adımı.

      Yaş ve kaynak adımlarıyla AYNI ekranda, aynı ilerleme çubuğunun altında: sorular tek
      bir yerde sorulsun diye. Eskiden ayrı bir fragment olarak üste ekleniyordu ve kendi
      ilerleme çubuğuyla ikinci bir akış gibi görünüyordu.

      Satırlar XML'de değil [StreakViews.buildOptionRows] ile üretiliyor — seri ekranındaki
      seçeneklerle birebir aynı görünsünler diye.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/streakContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintTop_toBottomOf="@id/userInfoProgress">

        <TextView
            android:id="@+id/streakStepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Her gün ne kadar öğrenmek istersin?" />

        <TextView
            android:id="@+id/streakStepSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:textColor="@color/dark_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/streakStepTitle"
            tools:text="Bu hedefi istediğin zaman değiştirebilirsin" />

        <LinearLayout
            android:id="@+id/streakOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/streakStepSubtitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      Meydan okuma sorusundan önceki niyet ekranı.

      Soru doğrudan gelseydi çocuk neyi neden seçtiğini bilmeden bir sayı seçerdi.
      Ders dönüşündeki yeni tur ekranı (fragment_new_streak) aynı metni ve aynı alevi
      kullanıyor: ikisi de aynı sözü istiyor, farklı görünmeleri için sebep yok.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/challengeIntroContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintTop_toBottomOf="@id/userInfoProgress">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/challengeIntroLottie"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_fileName="fire_anim.json"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/challengeIntroText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Şimdi bir öğrenme alışkanlığı kazanmana yardım edelim."
            android:textColor="@color/dark_text"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/challengeIntroLottie" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Devam Et Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="Devam Et"
        android:textAllCaps="false"
        android:layout_marginHorizontal="10dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:enabled="false"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/dark_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>




