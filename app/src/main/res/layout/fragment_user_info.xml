<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Geri Butonu -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="Geri"
        android:tint="@color/dark_text"
        app:srcCompat="@drawable/ic_back_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Yaş Adımı Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kaç yaşındasın?"
            android:textColor="@color/dark_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="140dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_edit_profile_input"
            android:gravity="center"
            android:hint="Yaş"
            android:textColorHint="@color/dark_text_secondary"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Kaynak Adımı Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sourceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnContinue">

        <TextView
            android:id="@+id/tvSourceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bizi nereden duydunuz?"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tvSourceTitle"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceFacebook"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Facebook"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceInstagram"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Instagram"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceYoutube"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Youtube"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceGoogle"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Google Araması"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceFriends"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Arkadaş/Aile"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceTiktok"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="TikTok"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceStore"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Uygulama Mağazası"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        android:id="@+id/cardSourceOther"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/background_color"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="2dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Diğer"
                            android:textColor="@color/dark_text"
                            android:gravity="center"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Devam Et Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="Devam Et"
        android:textAllCaps="false"
        android:layout_marginHorizontal="10dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:enabled="false"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/dark_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>




