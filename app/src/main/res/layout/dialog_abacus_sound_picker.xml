<?xml version="1.0" encoding="utf-8"?>
<!-- Ayarlar > Ses ekranındaki "Abaküs ses seçenekleri" satırına dokununca açılan panel. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_daily_question_continue"
    android:clipToOutline="true"
    android:padding="20dp">

    <ImageView
        android:id="@+id/abacusSoundPickerClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="@null"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="false"
        android:padding="8dp"
        android:src="@drawable/ic_close_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/abacusSoundPickerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="48dp"
        android:text="Abaküs Sesi Seç"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_regular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/abacusSoundPickerOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/abacusSoundPickerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

            <!-- Ses 1 -->
            <LinearLayout
                android:id="@+id/rowAbacusSound1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tutorial_option_row_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#8B949E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ses 1"
                    android:textColor="@color/dark_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/font_regular" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkAbacusSound1"
                    android:layout_width="@dimen/tutorial_options_checkbox_size"
                    android:layout_height="@dimen/tutorial_options_checkbox_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:button="@drawable/tutorial_option_checkbox_btn"
                    app:buttonTint="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Ses 2 -->
            <LinearLayout
                android:id="@+id/rowAbacusSound2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tutorial_option_row_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#8B949E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ses 2"
                    android:textColor="@color/dark_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/font_regular" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkAbacusSound2"
                    android:layout_width="@dimen/tutorial_options_checkbox_size"
                    android:layout_height="@dimen/tutorial_options_checkbox_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:button="@drawable/tutorial_option_checkbox_btn"
                    app:buttonTint="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Ses 3 -->
            <LinearLayout
                android:id="@+id/rowAbacusSound3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tutorial_option_row_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#8B949E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ses 3"
                    android:textColor="@color/dark_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/font_regular" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkAbacusSound3"
                    android:layout_width="@dimen/tutorial_options_checkbox_size"
                    android:layout_height="@dimen/tutorial_options_checkbox_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:button="@drawable/tutorial_option_checkbox_btn"
                    app:buttonTint="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Ses 4 -->
            <LinearLayout
                android:id="@+id/rowAbacusSound4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tutorial_option_row_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#8B949E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ses 4"
                    android:textColor="@color/dark_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/font_regular" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkAbacusSound4"
                    android:layout_width="@dimen/tutorial_options_checkbox_size"
                    android:layout_height="@dimen/tutorial_options_checkbox_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:button="@drawable/tutorial_option_checkbox_btn"
                    app:buttonTint="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Ses 5 -->
            <LinearLayout
                android:id="@+id/rowAbacusSound5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tutorial_option_row_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#8B949E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ses 5"
                    android:textColor="@color/dark_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/font_regular" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkAbacusSound5"
                    android:layout_width="@dimen/tutorial_options_checkbox_size"
                    android:layout_height="@dimen/tutorial_options_checkbox_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:button="@drawable/tutorial_option_checkbox_btn"
                    app:buttonTint="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
