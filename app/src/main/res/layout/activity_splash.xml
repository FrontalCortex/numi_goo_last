<?xml version="1.0" encoding="utf-8"?>
<!--
  Açılış: sistemin açılış ekranındaki ikonun (288dp tuvalde 160dp mor daire) aynısı ve altında "Sorobit".
  Çark ve "Öğrenmeye hazır mısın?" kaldırıldı (10.11.2026, kullanıcı kararı: Duolingo/Mimo gibi
  yalnızca marka). SplashActivity grubu önce ikon sistemin ikonuyla üst üste gelecek şekilde
  kaydırıyor, sonra yerine taşıyıp yazıyı belirginleştiriyor.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <LinearLayout
        android:id="@+id/splashBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Sistem ikonuyla aynı resim ve tuval (288dp); daire ortadaki 160dp, çevresi saydam. -->
        <ImageView
            android:id="@+id/splashIcon"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_icon" />

        <TextView
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-44dp"
            android:text="@string/activity_splash_text"
            android:textColor="@color/dark_text"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
