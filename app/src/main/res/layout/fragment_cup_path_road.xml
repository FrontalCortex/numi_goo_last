<?xml version="1.0" encoding="utf-8"?>
<!--
  Kupa yolu (Trophy Road) ekranı.

  Kullanıcının o kupa yolunda hangi eşikte olduğunu ve ileride hangi kupa sayılarında
  sandık kazanacağını gösterir. Üstteki özet, karttaki ilerleme çubuğunun aynısıdır
  (aynı çizimler, aynı yükseklik) — kullanıcı karttan buraya geçerken aynı şeye baktığını
  anlasın diye.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical">

    <!-- Üst çubuk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnCupPathRoadBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvCupPathRoadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="2"
            android:text="Kupa Yolu"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Toplama Kupa Yolu" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Güncel durum: kupa sayısı + sonraki eşiğe kalan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/infinity_cup_ic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCupPathRoadScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="1642" />

            <TextView
                android:id="@+id/tvCupPathRoadHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#93A5B3"
                android:textSize="13sp"
                tools:text="Sonraki sandık için 58 kupa" />

        </LinearLayout>

    </LinearLayout>

    <!--
      Buradaki ilerleme çubuğu KALDIRILDI.

      Aynı bilgiyi listenin kendisi gösteriyor: yolun üstündeki "şu an buradasın" etiketi
      hem kupa sayısını hem de sıradaki eşiğe ne kadar kaldığını yerinde anlatıyor. İkisi
      birden durunca kullanıcı üç ayrı yere (üstteki sayı, çubuk, liste) bakmak zorunda
      kalıyordu.
    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A3040" />

    <!-- Eşikler. Dikey liste: yol yukarıdan aşağı, küçük kupadan büyüğe ilerliyor. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cupPathRoadList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_cup_path_milestone" />

        <ProgressBar
            android:id="@+id/cupPathRoadLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>
