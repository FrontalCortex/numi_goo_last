<?xml version="1.0" encoding="utf-8"?>
<!--
  Abaküs boyut/boncuk ayar paneli: BlindingLessonFragment ile ödev oynatıcısında ortak; yönetimi
  abacus/AbacusSettingsPanel. Ekranın sağından kayarak giriyor (translationX), yeri <include> tarafında.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/guide_panel_background"
    android:elevation="12dp"
    android:padding="16dp"
    android:translationX="400dp"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/abacus_svg_ic"
                android:layout_marginBottom="12dp"/>

            <SeekBar
                android:id="@+id/seekBarScaleX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="100"
                android:progress="50"/>

            <SeekBar
                android:id="@+id/seekBarScaleY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="100"
                android:progress="50"/>

            <SeekBar
                android:id="@+id/seekBarMarginBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bead"
                android:layout_marginBottom="12dp"/>

            <SeekBar
                android:id="@+id/seekBarBeadScaleX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="100"
                android:progress="50"/>

            <SeekBar
                android:id="@+id/seekBarBeadScaleY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="100"
                android:progress="50"/>
                
            <SeekBar
                android:id="@+id/seekBarBeadMarginTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="30"
                android:progress="0"/>

            <SeekBar
                android:id="@+id/seekBarBeadMarginBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="0"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">
        <ImageButton
            android:id="@+id/abacusSettingsResetButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/special_reset_ic"
            android:scaleType="centerInside"
            android:background="@drawable/fab_background"
            android:layout_marginEnd="16dp"
            android:padding="8dp"/>
        <ImageButton
            android:id="@+id/abacusSettingsSaveButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/correct_ic"
            android:background="@drawable/fab_background"
            android:padding="6dp"/>
    </LinearLayout>

</LinearLayout>
