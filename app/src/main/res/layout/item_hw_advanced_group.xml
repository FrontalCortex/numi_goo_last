<?xml version="1.0" encoding="utf-8"?>
<!-- Gelişmiş panelinde bir kural (çarpmada bir basamak): başlık, "Tümü" ve rakam düğmeleri. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/HomeworkSectionCard">

    <LinearLayout style="@style/HomeworkSectionBody">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/groupTitle"
                style="@style/HomeworkSectionTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                tools:text="5'lik" />

            <TextView
                android:id="@+id/groupAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:text="@string/hw_advanced_select_all"
                android:textColor="@color/dark_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
