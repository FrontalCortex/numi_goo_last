<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HAFTALIK GÖREVLER ÇERÇEVESİ -->
        <LinearLayout
            android:id="@+id/weeklySectionFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mission_section_frame"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/weeklySectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:textColor="@color/missions_header_muted"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/missions_weekly_title" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/missions_header_muted"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:id="@+id/weeklySectionCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/missions_header_muted"
                    android:textSize="13sp"
                    tools:text="6 GÜN" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:background="#20FFFFFF" />

            <LinearLayout
                android:id="@+id/weeklyQuestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- GÜNLÜK GÖREVLER ÇERÇEVESİ -->
        <LinearLayout
            android:id="@+id/dailySectionFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_mission_section_frame"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/dailySectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:textColor="@color/missions_header_muted"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/missions_daily_title" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/missions_header_muted"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:id="@+id/dailySectionCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/missions_header_muted"
                    android:textSize="13sp"
                    tools:text="23 SA." />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:background="#20FFFFFF" />

            <LinearLayout
                android:id="@+id/dailyQuestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
