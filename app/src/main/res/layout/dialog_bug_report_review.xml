<?xml version="1.0" encoding="utf-8"?>
<!--
  Admin: tek bir bildirimin incelemesi (bkz. BugReportReviewDialogFragment).
  Üstte yakınlaştırılabilir ekran görüntüsü, altta metin, cihaz bilgisi ve karar düğmeleri.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/reviewClose"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/bug_report_close"
        android:textColor="@color/dark_primary"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <com.example.app.ZoomImageView
            android:id="@+id/reviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/bug_report_image_desc" />

        <ProgressBar
            android:id="@+id/reviewImageProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white" />

        <TextView
            android:id="@+id/reviewNoImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/font_regular"
            android:text="@string/bug_report_admin_no_image"
            android:textColor="@color/dark_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Uzun bir açıklama görseli ezmesin: alanı ağırlıkla sınırlı, içinde kayıyor. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/reviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_regular"
                android:textColor="@color/dark_text"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/reviewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/font_regular"
                android:textColor="@color/dark_text_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/reviewNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/hint_background"
                android:fontFamily="@font/font_regular"
                android:hint="@string/bug_report_admin_note_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/dark_text"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewApproveBig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/font_regular"
            android:minHeight="52dp"
            android:text="@string/bug_report_admin_approve_big"
            android:textAllCaps="false"
            android:textColor="@color/button_text_enabled"
            android:textSize="13sp"
            app:backgroundTint="@color/lesson_completed"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewApproveSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/font_regular"
            android:minHeight="52dp"
            android:text="@string/bug_report_admin_approve_small"
            android:textAllCaps="false"
            android:textColor="@color/button_text_enabled"
            android:textSize="13sp"
            app:backgroundTint="@color/lesson_header_yellow"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewReject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/font_regular"
            android:minHeight="52dp"
            android:text="@string/bug_report_admin_reject"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/lesson_header_red"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
