<?xml version="1.0" encoding="utf-8"?>
<!-- Ünite satırı (LessonItem.TYPE_HEADER). Tıklanınca dersleri açar/kapar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/lesson_header_blue"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="KURALSIZ TOPLAMA" />

    <TextView
        android:id="@+id/sectionProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/parent_text_muted"
        android:textSize="14sp"
        tools:text="4/4 ders" />

    <ImageView
        android:id="@+id/sectionChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:contentDescription="Dersleri göster"
        android:src="@drawable/dualingo_arrow_ic"
        app:tint="#607887" />
</LinearLayout>
