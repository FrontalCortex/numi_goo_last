<?xml version="1.0" encoding="utf-8"?>
<!-- Öğretici sonu kısa anketi (TutorialQuestionPanelFragment): tek soru, üç ifade.
     Seçim değiştirilebilir; 😕 seçilince "neresi zor geldi?" kutusu açılır. Geçiş "Devam" ile. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/questionScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/questionPanelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/tutorial_quick_survey_title"
                android:textColor="@color/dark_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/optionYes"
                    style="@style/TutorialQuickSurveyOption"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/optionYesEmoji"
                        style="@style/TutorialQuickSurveyEmoji" />

                    <TextView
                        style="@style/TutorialQuickSurveyLabel"
                        android:text="@string/tutorial_quick_survey_yes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/optionSome"
                    style="@style/TutorialQuickSurveyOption"
                    android:layout_marginHorizontal="6dp">

                    <TextView
                        android:id="@+id/optionSomeEmoji"
                        style="@style/TutorialQuickSurveyEmoji" />

                    <TextView
                        style="@style/TutorialQuickSurveyLabel"
                        android:text="@string/tutorial_quick_survey_some" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/optionNo"
                    style="@style/TutorialQuickSurveyOption"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/optionNoEmoji"
                        style="@style/TutorialQuickSurveyEmoji" />

                    <TextView
                        style="@style/TutorialQuickSurveyLabel"
                        android:text="@string/tutorial_quick_survey_no" />
                </LinearLayout>
            </LinearLayout>

            <!-- Yalnızca 😕 seçilince görünür -->
            <LinearLayout
                android:id="@+id/whyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/whyTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hint_background"
                    android:fontFamily="@font/font_regular"
                    android:gravity="top|start"
                    android:hint="@string/tutorial_quick_survey_why_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="@color/dark_text"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Bir ifade seçilince görünür; seçim değiştirilebilir, geçiş yalnızca bununla -->
            <Button
                android:id="@+id/continueButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/lesson_completed"
                android:fontFamily="@font/font_regular"
                android:paddingHorizontal="32dp"
                android:text="@string/tutorial_quick_survey_continue"
                android:textAllCaps="false"
                android:textColor="@color/button_text_enabled"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/skipButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@android:color/transparent"
                android:fontFamily="@font/font_regular"
                android:text="@string/tutorial_quick_survey_skip"
                android:textAllCaps="false"
                android:textColor="@color/dark_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Yazı gönderilirken ekranı kilitleyen katman -->
    <FrameLayout
        android:id="@+id/sendBlockingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
