<?xml version="1.0" encoding="utf-8"?>
<!--
  Sobi sekmesinin sohbet listesi (SobiChatFragment): "Yeni sohbet", önceki genel sohbetler (uzun basınca
  ya da sağa kaydırınca sil) ve altta sınıfı/eski soruları olan öğrenci için eski Sohbet ekranına geçiş.
  Telefonda soldan kayan çekmece, tablette solda kalıcı sütun.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/sobiDrawerNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_sobi_pill"
        android:gravity="center"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="@string/sobi_tab_new_chat"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        android:text="@string/sobi_tab_history"
        android:textColor="@color/dark_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sobiDrawerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/sobiDrawerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/sobi_tab_no_history"
            android:textColor="@color/dark_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/sobiDrawerMyClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:text="@string/sobi_tab_my_class"
        android:textColor="#1CB0F6"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
