<?xml version="1.0" encoding="utf-8"?>
<!--
  Sobi sekmesinin sohbet listesi (SobiChatFragment): "Yeni sohbet" ve önceki genel sohbetler (uzun basınca
  ya da sağa kaydırınca sil). Telefonda soldan kayan çekmece, tablette solda kalıcı sütun.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/sobiDrawerNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_sobi_pill"
        android:gravity="center"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="@string/sobi_tab_new_chat"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        android:text="@string/sobi_tab_history"
        android:textColor="@color/dark_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Başlıklarda arama (SobiChatFragment.applyFilter). -->
    <EditText
        android:id="@+id/sobiDrawerSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/chat_bubble_sobi"
        android:hint="@string/sobi_tab_search"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:textColor="@color/dark_text"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sobiDrawerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/sobiDrawerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/sobi_tab_no_history"
            android:textColor="@color/dark_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
