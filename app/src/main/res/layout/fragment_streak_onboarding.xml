<?xml version="1.0" encoding="utf-8"?>
<!--
  Seri kurulumu — ilk ders bittikten hemen sonra, kayıt ekranından önce.

  Dört adım tek düzende: üstte ilerleme çubuğu, ortada değişen içerik, altta tek buton.
  Adım başına ayrı fragment yapılmadı; dördü de aynı iskeleti kullanıyor ve aralarındaki
  tek fark orta alanın ne gösterdiği. Ayrı fragment'ler bu iskeleti dört kez kopyalamak
  ve geri tuşu davranışını dört yerde doğru yazmak demekti.

  Seçenek satırları ve hafta şeridi koddan üretiliyor: ikisi de yinelenen öğeler ve
  XML'de tutulsalardı her satır için ayrı kimlik taşımak gerekirdi.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:id="@+id/streakOnboardingProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:max="100"
        android:progress="25"
        android:progressTint="#FF9800"
        android:progressBackgroundTint="#2E4149"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/streakOnboardingContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/streakOnboardingProgress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/streakOnboardingIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@null"
                android:src="@drawable/streak_flame_ic" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/streakOnboardingLottie"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_fileName="fire_anim.json"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/streakOnboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Her gün ne kadar öğrenmek istersin?" />

            <TextView
                android:id="@+id/streakOnboardingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#93A5B3"
                android:textSize="15sp"
                tools:text="Bu hedefi istediğin zaman değiştirebilirsin" />

            <LinearLayout
                android:id="@+id/streakOnboardingOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/streakOnboardingWeekStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_streak_option"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="14dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/streakOnboardingChallengeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_streak_option"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/streak_flame_ic" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/streakOnboardingChallengeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="3 Günlük Meydan Okuma" />

                    <TextView
                        android:id="@+id/streakOnboardingChallengeSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#93A5B3"
                        android:textSize="13sp"
                        tools:text="3 GÜNÜN 1. GÜNÜ" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/streakOnboardingContinue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_streak_continue"
        android:text="Devam et"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
