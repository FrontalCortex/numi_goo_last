<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_parent_consent_title"
            android:textColor="@color/dark_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fragment_parent_consent_message"
            android:textColor="@color/dark_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fragment_parent_consent_collected_title"
            android:textColor="@color/dark_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/fragment_parent_consent_collected_list"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="@color/dark_surface"
            app:hintTextColor="@color/dark_text_secondary"
            app:startIconTint="@color/dark_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etParentEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/fragment_parent_consent_et_hint"
                android:inputType="textEmailAddress"
                android:maxLength="254"
                android:textColor="@color/dark_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendParentCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/fragment_parent_consent_btn_send"
            android:textSize="16sp"
            app:backgroundTint="@color/dark_primary"
            app:cornerRadius="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fragment_parent_consent_note"
            android:textColor="@color/dark_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
