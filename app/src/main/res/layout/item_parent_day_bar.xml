<?xml version="1.0" encoding="utf-8"?>
<!-- Özet kartındaki 7 günlük şeridin tek sütunu. Yükseklik kodda veriliyor
     (bkz. ParentReportAdapter.SummaryHolder.bindWeekStrip). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dayBarValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/parent_text_muted"
        android:textSize="10sp"
        tools:text="24" />

    <!-- Sabit yükseklikli ray: sütunlar aynı tabandan kalksın. -->
    <FrameLayout
        android:layout_width="14dp"
        android:layout_height="52dp">

        <View
            android:id="@+id/dayBarFill"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/parent_step_not_reached" />
    </FrameLayout>

    <TextView
        android:id="@+id/dayBarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/parent_text_muted"
        android:textSize="11sp"
        tools:text="Pzt" />
</LinearLayout>
