<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050C38">

    <!-- Close Button -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SUPER Badge -->
    <TextView
        android:id="@+id/superBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_shop_super_badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="PRO"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose" />

    <!-- Center Mascot -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/centerMascot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="50dp"
        app:lottie_fileName="rocket_anim.json"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintBottom_toTopOf="@id/bottomWhiteContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintWidth_percent="0.5" />

    <!-- Bottom White Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomWhiteContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_white"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- SUPER Column Background -->
        <View
            android:id="@+id/superColumnBg"
            android:layout_width="80dp"
            android:layout_height="0dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_super_column"
            app:layout_constraintBottom_toTopOf="@id/btnTryFree"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginBottom="16dp"/>

        <!-- Headers -->
        <TextView
            android:id="@+id/tvHeaderFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-black"
            android:text="ÜCRETSİZ"
            android:textColor="#4A4A4A"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderSuper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shop_super_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="PRO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvHeaderFree"/>

        <!-- Row 1 -->
        <TextView
            android:id="@+id/row1Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:text="Ders içerikleri"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderFree" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:tint="#4A4A4A"
            app:layout_constraintBottom_toBottomOf="@id/row1Text"
            app:layout_constraintEnd_toEndOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="@id/tvHeaderFree"
            app:layout_constraintTop_toTopOf="@id/row1Text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:layout_constraintBottom_toBottomOf="@id/row1Text"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="@id/row1Text" />

        <!-- Row 2 -->
        <TextView
            android:id="@+id/row2Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="Sınırsız can"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/row1Text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="#999999"
            app:layout_constraintBottom_toBottomOf="@id/row2Text"
            app:layout_constraintEnd_toEndOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="@id/tvHeaderFree"
            app:layout_constraintTop_toTopOf="@id/row2Text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:layout_constraintBottom_toBottomOf="@id/row2Text"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="@id/row2Text" />

        <!-- Row 3 -->
        <TextView
            android:id="@+id/row3Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="Reklamsız öğrenim"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/row2Text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="#999999"
            app:layout_constraintBottom_toBottomOf="@id/row3Text"
            app:layout_constraintEnd_toEndOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="@id/tvHeaderFree"
            app:layout_constraintTop_toTopOf="@id/row3Text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:layout_constraintBottom_toBottomOf="@id/row3Text"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="@id/row3Text" />

        <!-- Row 4 -->
        <TextView
            android:id="@+id/row4Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="Ustalık Yolu"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/row3Text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="#999999"
            app:layout_constraintBottom_toBottomOf="@id/row4Text"
            app:layout_constraintEnd_toEndOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="@id/tvHeaderFree"
            app:layout_constraintTop_toTopOf="@id/row4Text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:layout_constraintBottom_toBottomOf="@id/row4Text"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="@id/row4Text" />

        <!-- Row 5 -->
        <TextView
            android:id="@+id/row5Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="Danışma kredilerinde %20 bonus"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/row4Text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="#999999"
            app:layout_constraintBottom_toBottomOf="@id/row5Text"
            app:layout_constraintEnd_toEndOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="@id/tvHeaderFree"
            app:layout_constraintTop_toTopOf="@id/row5Text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:layout_constraintBottom_toBottomOf="@id/row5Text"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="@id/row5Text" />


        <!-- Row 6 -->
        <TextView
            android:id="@+id/row6Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="Hoş geldin: 1 danışma kredisi"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/row5Text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="—"
            android:textColor="#999999"
            app:layout_constraintBottom_toBottomOf="@id/row6Text"
            app:layout_constraintEnd_toEndOf="@id/tvHeaderFree"
            app:layout_constraintStart_toStartOf="@id/tvHeaderFree"
            app:layout_constraintTop_toTopOf="@id/row6Text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/correct_ic2"
            app:layout_constraintBottom_toBottomOf="@id/row6Text"
            app:layout_constraintEnd_toEndOf="@id/superColumnBg"
            app:layout_constraintStart_toStartOf="@id/superColumnBg"
            app:layout_constraintTop_toTopOf="@id/row6Text" />

        <!-- Button -->
        <FrameLayout
            android:id="@+id/btnTryFree"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_blue_rounded_button"
            app:layout_constraintTop_toBottomOf="@id/row6Text">

            <TextView
                android:id="@+id/btnTryFreeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="₺0,00 ÖDEYEREK DENE"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
