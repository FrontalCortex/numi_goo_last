<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview abacus for AbacusCustomizationFragment.
  Dimensions and spacing are IDENTICAL to fragment_abacus.xml so the
  preview matches the real abacus exactly (rod width 45dp, padding 20/24dp).
  Bead IDs follow the same rod{n}_bead_bottom{1..4} / rod{n}_bead_top / rod{n}_barrier
  convention so AbacusBeadController.setup() finds them automatically.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
