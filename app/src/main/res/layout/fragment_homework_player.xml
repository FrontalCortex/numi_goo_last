    <Button
        android:id="@+id/kontrolButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/tutorial_back_button_size"
        android:layout_marginStart="@dimen/tutorial_control_button_side_margin"
        android:layout_marginEnd="@dimen/tutorial_control_button_side_margin"
        android:layout_marginBottom="@dimen/tutorial_bottom_panel_margin_bottom"
        android:background="@drawable/bg_depth_hw_control"
        android:elevation="0dp"
        android:fontFamily="@font/font_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxHeight="@dimen/tutorial_back_button_size"
        android:minHeight="@dimen/tutorial_back_button_size"
        android:paddingTop="0dp"
        android:paddingBottom="4dp"
        android:stateListAnimator="@null"
        android:text="@string/hw_player_check"
        android:textAllCaps="false"
        android:textColor="@color/hw_control_text"
        android:textSize="@dimen/tutorial_control_button_text_size"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      Sağdaki düğmeler ve paneller kupa yolundaki BlindingLessonFragment ile aynı (fragment_blinding_lesson.xml);
      davranışları ortak yardımcılarda: abacus/LessonRulesPanel, abacus/AbacusSettingsPanel, abacus/LessonSideButtons.
      Sütun alttan yukarı: abaküs ayarı, atla, kural paneli, sıfırla. Kural kitabı sağ üstte. Dersteki eksi
      kenar payı (-10 dp, düğmeler yarı dışarıda) burada yok: düğmeler ekranın sağ kenarına tam oturuyor.
    -->
    <FrameLayout
        android:id="@+id/rulesFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        app:layout_constraintTop_toBottomOf="@id/flashCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/abacusContainer" />

    <ImageView
        android:id="@+id/rulesBookButton"
        android:layout_width="@dimen/abacus_fragment_rules_book_size"
        android:layout_height="@dimen/abacus_fragment_rules_book_size"
        android:layout_marginEnd="0dp"
        android:background="@drawable/fab_background"
        android:contentDescription="@null"
        android:padding="@dimen/abacus_fragment_rules_book_padding"
        android:src="@drawable/math_book_ic2"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/resetButton"
        android:layout_width="@dimen/abacus_side_button_size"
        android:layout_height="@dimen/abacus_side_button_size"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="@dimen/abacus_fragment_ask_button_margin_top"
        android:background="@drawable/fab_background"
        android:elevation="10dp"
        android:padding="5dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/rulesPanelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/reset" />

    <ImageView
        android:id="@+id/rulesPanelButton"
        android:layout_width="@dimen/abacus_side_button_size"
        android:layout_height="@dimen/abacus_side_button_size"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="@dimen/abacus_fragment_ask_button_margin_top"
        android:background="@drawable/fab_background"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:padding="@dimen/tutorial_rules_panel_button_padding"
        android:src="@drawable/magic_wand_ic"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/skipStepButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/skipStepButton"
        android:layout_width="@dimen/abacus_side_button_size"
        android:layout_height="@dimen/abacus_side_button_size"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="@dimen/abacus_fragment_ask_button_margin_top"
        android:background="@drawable/fab_background"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/abacusModeButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="skip_step_arrow_anim.json"
        app:lottie_loop="false" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/abacusModeButton"
        android:layout_width="@dimen/abacus_side_button_size"
        android:layout_height="@dimen/abacus_side_button_size"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="@dimen/abacus_fragment_ask_button_margin_top"
        android:background="@drawable/fab_background"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/kontrolButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="abacus_mode_ic_anim.json"
        app:lottie_loop="false" />

    <!-- Kural paneli kartın altından abaküsün üstüne kadar uzayabiliyor; içerik kısaysa abaküse yapışık. -->
    <include
        android:id="@+id/rulesPanelScrollView"
        layout="@layout/view_rules_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-5dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintTop_toBottomOf="@id/flashCard"
        app:layout_constraintBottom_toTopOf="@id/abacusContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/abacusSettingsPanel"
        layout="@layout/view_abacus_settings_panel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1" />

    <!-- Doğru / yanlış paneli (yan düğmelerin, elevation 10dp, üstünde kalsın: dersteki gibi 14dp) -->
    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="@dimen/tutorial_result_panel_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/tutorial_result_title_text_size"
            android:textStyle="bold"
            tools:text="Doğru!" />

        <TextView
            android:id="@+id/resultMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/tutorial_result_body_text_size"
            android:visibility="gone"
            tools:text="Doğru cevap: 123" />

        <!-- Sobi testinde yanlışta: soru Sobi ekranında adım adım (yalnızca Sobi testi kipi). -->
        <LinearLayout
            android:id="@+id/resultSobiAnalyze"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hw_send"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <com.example.app.SobiHeadView
                android:layout_width="30dp"
                android:layout_height="30dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/review_open_button"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/resultButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tutorial_result_button_height"
            android:layout_marginTop="@dimen/tutorial_result_button_top_margin"
            android:background="@drawable/bg_depth_tutorial_continue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="4dp"
            android:stateListAnimator="@null"
            android:text="@string/hw_player_next"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="@dimen/tutorial_result_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Adım sonu / ödev bitti / açılamadı -->
    <LinearLayout
        android:id="@+id/summaryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/summaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/dark_text"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Adım bitti!" />

        <TextView
            android:id="@+id/summaryScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#8CC63F"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="8/10 doğru" />

        <TextView
            android:id="@+id/summaryMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/dark_text_secondary"
            android:textSize="15sp"
            tools:text="5'lik ve 10'luk toplama · 1/3 adım" />

        <ProgressBar
            android:id="@+id/summaryProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/summaryPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_add_friend_btn"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Sonraki adım" />

        <TextView
            android:id="@+id/summarySecondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:textColor="@color/dark_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Bitir" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
