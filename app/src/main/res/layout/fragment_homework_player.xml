<?xml version="1.0" encoding="utf-8"?>
<!--
  Ödev oynatıcısı (bkz. homework/HomeworkPlayerFragment). Abaküs bloğu fragment_abacus_practice.xml
  dosyasından olduğu gibi alındı: AbacusBeadController boncukları kimlikle (rodN_bead_*) buluyor.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true">

    <ImageButton
        android:id="@+id/quitButton"
        android:layout_width="@dimen/abacus_fragment_quit_size"
        android:layout_height="@dimen/abacus_fragment_quit_size"
        android:layout_margin="10dp"
        android:background="@drawable/cross"
        android:contentDescription="@string/hw_player_quit_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/stepText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/quitButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/quitButton"
        tools:text="Adım 1/3 · Soru 2/10" />

    <!--
      Sayıların göründüğü kart. Eskiden 360 dp'lik kara tahta görseliydi; kural paneli (abaküsün üstünde
      açılıyor) tahtanın üstüne biniyordu. Sade ve alçak kart: üstte kalıyor, panelle çakışmıyor.
    -->
    <View
        android:id="@+id/flashCard"
        android:layout_width="0dp"
        android:layout_height="@dimen/flash_card_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_flash_card"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quitButton" />

    <!-- Gösterilen sayı (ya da çarpma işlemi). Uzun sayılarda yazı kodda küçültülüyor. -->
    <TextView
        android:id="@+id/flashText"
        android:layoutDirection="ltr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/dark_text"
        android:textSize="@dimen/hw_flash_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/flashCard"
        app:layout_constraintRight_toRightOf="@id/flashCard"
        app:layout_constraintLeft_toLeftOf="@id/flashCard"
        app:layout_constraintTop_toTopOf="@id/flashCard"
        tools:text="123" />

    <!--
      Abaküssüzde cevap alanı: Kontrol düğmesinin hemen üstünde. Klavye açılınca ekran küçülüyor
      (adjustResize) ve düğmeyle birlikte klavyenin üstüne çıkıyor; tahtanın altına bağlıyken klavyenin
      arkasında kalıyordu. Abaküssüzde abaküs gizli olduğu için burası boş.
    -->
    <EditText
        android:id="@+id/answerInput"
        android:layoutDirection="ltr"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_edit_profile_input"
        android:gravity="center"
        android:hint="@string/hw_player_answer_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="12"
        android:maxLines="1"
        android:textColor="@color/dark_text"
        android:textColorHint="@color/dark_text_secondary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/kontrolButton"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <FrameLayout
        android:id="@+id/abacusContainer"
        android:layoutDirection="ltr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/abacus_frame_bg"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="@dimen/tutorial_abacus_linear_margin_bottom"
        app:layout_constraintBottom_toTopOf="@id/kontrolButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

