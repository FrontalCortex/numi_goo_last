<?xml version="1.0" encoding="utf-8"?>
<!--
  Sobi'nin Pro deneme tanıtımı (SobiProTrialFragment). Düzen öğretmen tanıtımıyla
  (fragment_ask_question_open.xml) aynı aileden: üstte lacivert zemin ve Sobi, altta beyaz kutu.
  Fayda satırları kodda ekleniyor (benefitList): hoş geldin satırı cihaz uygunluğuna göre düşüyor.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050C38">

    <TextView
        android:id="@+id/superBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_shop_super_badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="@string/fragment_ask_question_open_super_badge"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/superBadge" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/sobi_trial_subtitle"
        android:textColor="#C9D1FF"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <!-- Sobi; görünüm kendini kare alana sığdırıyor (oynatma SobiProTrialFragment'ta). -->
    <com.example.app.BunnyMascotView
        android:id="@+id/mascotView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomWhiteScroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintWidth_percent="0.75" />

    <!-- Beyaz bölüm içeriği kadar yüksek, ekranın altına yaslı; küçük ekranda başlığın altına kadar
         uzayıp kayıyor (ProDiffirent'teki gibi). İçteki kutunun id'si SystemBarColors için. -->
    <ScrollView
        android:id="@+id/bottomWhiteScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_white"
        android:overScrollMode="ifContentScrolls"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintVertical_bias="1">

        <LinearLayout
            android:id="@+id/bottomWhiteContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/benefitList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:orientation="vertical" />

            <FrameLayout
                android:id="@+id/btnTryFree"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_blue_rounded_button">

                <TextView
                    android:id="@+id/tryFreeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnNotNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:padding="8dp"
                android:text="@string/sobi_trial_not_now"
                android:textColor="#3D4DFF"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
