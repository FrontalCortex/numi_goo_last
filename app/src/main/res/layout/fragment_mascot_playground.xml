<?xml version="1.0" encoding="utf-8"?>
<!--
  Karakter animasyonu deneme ekranı (Görevler → "Karakter Animasyonu" kartı).
  Tavşan hep bekleme hâlinde; aşağıdaki seçeneklerden biri seçilince o hâli bir kez oynatıp
  beklemeye dönüyor. Kök tıklanabilir: altındaki ekrana dokunuş geçmesin.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Kapat"
        android:textColor="@color/dark_primary"
        android:textSize="16sp"
        android:fontFamily="@font/font_regular"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Karakter Animasyonu"
        android:textColor="@color/dark_text"
        android:textSize="18sp"
        android:fontFamily="@font/font_regular"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.app.BunnyMascotView
        android:id="@+id/mascotView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintWidth_percent="0.75"
        app:layout_constraintWidth_max="340dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Bekleme"
        android:textColor="@color/dark_text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/font_regular"
        app:layout_constraintTop_toBottomOf="@id/mascotView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alt boşluk büyük: listenin sonu telefonun alt çubuğunun arkasında kalıyordu. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvCurrent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/emoteChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="120dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp"
            app:singleSelection="true" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
