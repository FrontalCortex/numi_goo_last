<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/notification_header_padding_h"
        android:paddingEnd="@dimen/notification_header_padding_h"
        android:paddingTop="@dimen/notification_header_padding_top"
        android:paddingBottom="@dimen/notification_header_padding_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_notification_notification_title"
            android:textSize="@dimen/notification_title_text_size"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:id="@+id/teacherTabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="3dp"
            android:layout_marginTop="@dimen/notification_student_tabs_margin_top"
            android:background="@drawable/bg_segment_control">

            <TextView
                android:id="@+id/tabPool"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/notification_tab_height"
                android:paddingStart="@dimen/notification_tab_padding_h"
                android:paddingEnd="@dimen/notification_tab_padding_h"
                android:gravity="center"
                android:text="@string/fragment_notification_tab_pool"
                android:textSize="@dimen/notification_tab_text_size"
                android:textStyle="bold"
                android:background="@drawable/bg_segment_selected"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tabChats"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/notification_tab_height"
                android:paddingStart="@dimen/notification_tab_padding_h"
                android:paddingEnd="@dimen/notification_tab_padding_h"
                android:gravity="center"
                android:text="@string/fragment_notification_tab_chats"
                android:textSize="@dimen/notification_tab_text_size"
                android:textStyle="bold"
                android:textColor="@color/dark_text_secondary" />

            <TextView
                android:id="@+id/tabReports"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/notification_tab_height"
                android:paddingStart="@dimen/notification_tab_padding_h"
                android:paddingEnd="@dimen/notification_tab_padding_h"
                android:gravity="center"
                android:text="@string/fragment_notification_tab_reports"
                android:textSize="@dimen/notification_tab_text_size"
                android:textStyle="bold"
                android:textColor="@color/dark_text_secondary" />
        </LinearLayout>

        <!--
          Kurs öğretmeni: havuz alt sekmeleri (yalnızca iki havuzu da görüyorsa) ve "Sınıflarım".
          Üç sekmenin yanına sığmadığı için ayrı satırda (bkz. NotificationFragment.updatePoolOptionsRow).
        -->
        <LinearLayout
            android:id="@+id/poolOptionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/poolSubTabContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_control"
                android:orientation="horizontal"
                android:padding="3dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/poolSubTabMine"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_segment_selected"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/class_pool_tab_mine"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/poolSubTabGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/class_pool_tab_general"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnTeacherClasses"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_outline"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/class_classes_button"
                android:textColor="@color/dark_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reportsSubTabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="3dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_segment_control">

            <TextView
                android:id="@+id/subTabReportsList"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="130dp"
                android:gravity="center"
                android:text="@string/fragment_notification_sub_tab_reports_list"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_segment_selected" />

            <TextView
                android:id="@+id/subTabRestrictedUsers"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="130dp"
                android:gravity="center"
                android:text="@string/fragment_notification_sub_tab_restricted_users"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studentTabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="3dp"
            android:layout_marginTop="@dimen/notification_student_tabs_margin_top"
            android:background="@drawable/bg_segment_control">

            <TextView
                android:id="@+id/tabBekleyen"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/notification_tab_height"
                android:paddingStart="@dimen/notification_tab_padding_h"
                android:paddingEnd="@dimen/notification_tab_padding_h"
                android:gravity="center"
                android:text="@string/fragment_notification_tab_bekleyen"
                android:textSize="@dimen/notification_tab_text_size"
                android:textStyle="bold"
                android:background="@drawable/bg_segment_selected"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tabCozulen"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/notification_tab_height"
                android:paddingStart="@dimen/notification_tab_padding_h"
                android:paddingEnd="@dimen/notification_tab_padding_h"
                android:gravity="center"
                android:text="@string/fragment_notification_tab_cozulen"
                android:textSize="@dimen/notification_tab_text_size"
                android:textStyle="bold"
                android:textColor="@color/dark_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/questionsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/notification_list_padding"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_question" />

    <!-- Sohbet açılmadan önce mesajlar preload edilirken gösterilen loading -->
    <ProgressBar
        android:id="@+id/chatLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="@dimen/notification_loading_size"
        android:layout_height="@dimen/notification_loading_size"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fragment_notification_empty_text"
        android:textColor="#888888"
        android:textSize="@dimen/notification_empty_text_size"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Öğretmen hesabı onay beklerken: sadece bu blok gösterilir -->
    <LinearLayout
        android:id="@+id/teacherApprovalPendingContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/notification_pending_container_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/teacherApprovalPendingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_notification_teacher_approval_pending_message"
            android:textSize="@dimen/notification_pending_message_text_size"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/notification_pending_line_spacing_extra" />

        <Button
            android:id="@+id/teacherApprovalSupportButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/notification_pending_button_margin_top"
            android:textSize="@dimen/notification_pending_button_text_size"
            android:text="@string/fragment_notification_teacher_approval_support_button"
            android:textColor="@android:color/white"
            android:background="@drawable/hint_background" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
