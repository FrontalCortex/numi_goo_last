<?xml version="1.0" encoding="utf-8"?>
<!-- Öğretici ekranında hep duran "Sobi'ye sor" düğmesi: Sobi'nin kafası ve yazı, göçen mavi düğme
     (TutorialFragment.updateSobiFloatingButton). Yanlış cevap panelindeki düğmeyle aynı görünüm. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:background="@drawable/bg_hw_send"
    android:elevation="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <com.example.app.SobiHeadView
        android:layout_width="26dp"
        android:layout_height="26dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="@string/sobi_ask_button"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
