<?xml version="1.0" encoding="utf-8"?>
<!--
  Kupa yolundaki tek bir eşik: yolu temsil eden şerit, üstünde sandık, altında kupa sayısı.

  Şerit öğenin tamamı kadar geniş; öğeler yan yana dizilince kesintisiz bir yol oluşuyor.
  Şeridin rengi ve sandığın durumu koddan veriliyor (bkz. CupPathRoadFragment).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="88dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">

        <View
            android:id="@+id/milestoneTrack"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@null" />

        <FrameLayout
            android:id="@+id/milestoneChestBox"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/milestoneChest"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/new_chest_close_ic1" />

            <ImageView
                android:id="@+id/milestoneDone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:src="@drawable/ic_done"
                android:visibility="gone"
                app:tint="#21D07A" />

        </FrameLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/milestoneCupIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/infinity_cup_ic" />

        <TextView
            android:id="@+id/milestoneValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:includeFontPadding="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="300" />

    </LinearLayout>

    <TextView
        android:id="@+id/milestoneStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:minHeight="16dp"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="HAZIR" />

</LinearLayout>
