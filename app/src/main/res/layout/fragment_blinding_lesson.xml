        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/startButton"/>


    <!-- İpucu balonu fragment_abacus.xml'deki ile aynı; neden kırpılmadığı orada anlatılıyor. -->
    <FrameLayout
        android:id="@+id/hintContainer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/abacus_side_button_size"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/abacus_fragment_ask_button_margin_top"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/askQuestionButton">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/abacus_fragment_hint_bubble_overflow"
            android:layout_marginBottom="@dimen/abacus_fragment_hint_bubble_overflow"
            android:clipChildren="false"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/abacus_side_button_size"
                android:gravity="center_vertical"
                android:background="@drawable/hint_bubble_background"
                android:textColor="@android:color/white"
                android:layout_marginEnd="@dimen/abacus_fragment_hint_tv_margin_end"
                android:paddingStart="@dimen/abacus_fragment_hint_tv_padding_start"
                android:paddingTop="@dimen/abacus_fragment_hint_tv_padding_vertical"
                android:paddingEnd="@dimen/abacus_fragment_hint_tv_padding_end"
                android:paddingBottom="@dimen/abacus_fragment_hint_tv_padding_vertical"
                android:lineSpacingExtra="@dimen/abacus_fragment_hint_tv_line_spacing"
                android:visibility="invisible"
                android:textSize="@dimen/abacus_fragment_hint_tv_text_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="MissingConstraints" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/fabHint"
            android:layout_width="@dimen/abacus_side_button_size"
            android:layout_height="@dimen/abacus_side_button_size"
            android:background="@drawable/fab_background"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            android:translationZ="3dp"
            android:padding="5dp"
            tools:visibility="gone"
            app:lottie_rawRes="@raw/lesson_hint_ic"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-25dp" />
    </FrameLayout>

    <View
        android:id="@+id/fabHintTouchArea"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="-15dp"
        app:layout_constraintBottom_toTopOf="@id/numberInput"
        app:layout_constraintTop_toBottomOf="@id/blackboardImage"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/incorrectPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:clickable="false"
        android:descendantFocusability="blocksDescendants"
        android:elevation="14dp"
        android:padding="3dp"
        android:fitsSystemWindows="true"
        android:layout_marginStart="@dimen/abacus_fragment_result_panel_margin_neg"
        android:layout_marginEnd="@dimen/abacus_fragment_result_panel_margin_neg"
        android:layout_marginBottom="@dimen/abacus_fragment_result_panel_margin_neg"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:translationZ="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/incorrectIcon"
            android:layout_width="@dimen/tutorial_result_icon_size"
            android:layout_height="@dimen/tutorial_result_icon_size"
            android:layout_margin="@dimen/tutorial_result_item_margin"
            android:src="@android:drawable/ic_delete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FF4B4B" />

        <TextView
            android:id="@+id/incorrectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/tutorial_result_item_margin"
            android:layout_marginStart="@dimen/tutorial_result_title_start_margin"
            android:text="@string/fragment_blinding_lesson_incorrect_text"
            android:textColor="#FF4B4B"
            android:textSize="@dimen/tutorial_result_title_text_size"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/incorrectIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/correctAnswerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/tutorial_result_item_margin"
            android:layout_marginTop="@dimen/tutorial_result_label_top_margin"
            android:text=""
            android:textColor="#FF4B4B"
            android:textSize="@dimen/tutorial_result_body_text_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/incorrectText" />

        <TextView
            android:id="@+id/correctAnswerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:layout_margin="@dimen/tutorial_result_item_margin"
            android:textSize="@dimen/tutorial_result_body_text_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/correctAnswerLabel" />

        <!-- "Sobi ile analiz et": soru abaküste adım adım yeniden çözülür, hatanın yeri bulunur
             (BlindingLessonFragment.bindReviewButton, MistakeReviewDialog). -->
        <LinearLayout
            android:id="@+id/incorrectSobiAnalyze"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_margin="@dimen/tutorial_result_item_margin"
            android:background="@drawable/bg_hw_send"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.example.app.SobiHeadView
                android:layout_width="30dp"
                android:layout_height="30dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/review_open_button"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/okayButton"
            android:background="@drawable/bg_depth_tutorial_okay"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/tutorial_panel_button_height"
            android:paddingTop="0dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tutorial_panel_button_height"
            android:layout_marginTop="@dimen/tutorial_result_button_top_margin"
            android:text="@string/fragment_blinding_lesson_okay_button"
            android:layout_marginHorizontal="@dimen/tutorial_result_item_margin"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="@dimen/tutorial_result_button_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/correctAnswerText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/correctPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:clickable="false"
        android:descendantFocusability="blocksDescendants"
        android:elevation="14dp"
        android:padding="@dimen/tutorial_result_panel_padding"
        android:clipToPadding="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:translationZ="0dp"
        android:layout_marginStart="@dimen/abacus_fragment_result_panel_margin_neg"
        android:layout_marginEnd="@dimen/abacus_fragment_result_panel_margin_neg"
        android:layout_marginBottom="@dimen/abacus_fragment_result_panel_margin_neg"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/correctIcon"
            android:layout_width="@dimen/tutorial_result_icon_size"
            android:layout_height="@dimen/tutorial_result_icon_size"
            android:src="@drawable/circle_correct"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/correctText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tutorial_result_title_start_margin"
            android:text="@string/fragment_blinding_lesson_correct_text"
            android:textColor="#8CC63F"
            android:textSize="@dimen/tutorial_result_title_text_size"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/correctIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/continueButton"
            android:background="@drawable/bg_depth_tutorial_continue"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="@dimen/tutorial_panel_button_height"
            android:paddingTop="0dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/tutorial_panel_button_height"
            android:layout_marginTop="@dimen/tutorial_result_button_top_margin"
            android:text="@string/fragment_blinding_lesson_continue_button"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="@dimen/tutorial_result_button_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/correctText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/startButton"
        android:background="@drawable/bg_depth_tutorial_control"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="@dimen/tutorial_control_button_height"
        android:paddingTop="0dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/tutorial_control_button_height"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/font_regular"
        android:text="@string/fragment_blinding_lesson_start_button"
        android:visibility="visible"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="0dp"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/abacusSettingsPanel"
        layout="@layout/view_abacus_settings_panel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1" />

    <include
        layout="@layout/view_guide_panel"
        android:id="@+id/guidePanelInclude"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/abacusContainer"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>