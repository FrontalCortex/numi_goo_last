    <!-- Kural paneli zamanlayıcının altından abaküsün üstüne kadar uzayabiliyor; içerik kısaysa abaküse yapışık. -->
    <include
        android:id="@+id/rulesPanelScrollView"
        layout="@layout/view_rules_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="-5dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintTop_toBottomOf="@id/timerTextView"
        app:layout_constraintBottom_toTopOf="@id/abacusContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/kontrolButton"
        android:background="@drawable/bg_depth_hw_control"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="@dimen/tutorial_control_button_height"
        android:paddingTop="0dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/tutorial_control_button_height"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/font_regular"
        android:text="@string/fragment_blinding_lesson_kontrol_button"
        android:visibility="invisible"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="0dp"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <View
