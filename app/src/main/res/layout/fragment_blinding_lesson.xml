<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".BlindingLessonFragment"
    android:background="@color/background_color"
    android:padding="10dp"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    >
    <ImageButton
        android:id="@+id/quitButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="-5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/rulesBookButton"
        android:layout_width="@dimen/abacus_fragment_rules_book_size"
        android:layout_height="@dimen/abacus_fragment_rules_book_size"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        android:padding="@dimen/abacus_fragment_rules_book_padding"
        android:layout_marginEnd="@dimen/abacus_fragment_rules_book_margin_end"
        android:background="@drawable/fab_background"
        android:src="@drawable/math_book_ic2">

    </ImageView>
    <ImageView
        android:id="@+id/askQuestionButton"
        android:layout_width="@dimen/abacus_side_button_size"
        android:layout_height="@dimen/abacus_side_button_size"
        android:layout_marginBottom="@dimen/abacus_fragment_ask_button_margin_top"
        android:layout_marginEnd="@dimen/abacus_fragment_ask_button_margin_end"
        android:elevation="10dp"
        android:textAllCaps="false"
        android:padding="@dimen/tutorial_ask_button_padding"
        android:background="@drawable/fab_background"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/resetButton"
        android:src="@drawable/teacher_ask_ic"/>

    <TextView
        android:id="@+id/timerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="@color/yellow"
        android:textSize="18sp"
        android:visibility="visible"
        android:layout_marginTop="@dimen/abacus_fragment_timer_margin_top"
        app:layout_constraintTop_toBottomOf="@id/blackboardImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        app:lottie_autoPlay="false"
        android:translationZ="10dp"
        app:lottie_loop="false"
        android:visibility="gone"
        tools:visibility="gone"
        app:lottie_fileName="animaton_thirteen.json"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/rulesFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        app:layout_constraintTop_toBottomOf="@id/blackboardImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/abacusContainer"/>
    <LinearLayout
        android:id="@+id/progressBarContainer"
        android:layout_width="250dp"
        android:layout_height="16dp"
        android:orientation="horizontal"
        android:background="#333"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ExtraText">

        <View
            android:id="@+id/progressBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/progress_bar_fill"
            android:layout_weight="0" />

        <View
            android:id="@+id/progressBarEmpty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/progress_bar_fill"
            android:backgroundTint="#444"
            android:layout_weight="1" />
    </LinearLayout>


    <!--
      Sayı kartı (eski kara tahta görseli yerine; ödev oynatıcısıyla aynı, bg_flash_card). Kimlik eski
      adıyla kaldı: sayılar ve tahtanın altındakiler ona bağlı. Alçak olduğu için abaküsün üstünde açılan
      kural paneline yer kalıyor.
    -->
    <ImageView
        android:id="@+id/blackboardImage"
        android:layout_width="0dp"
        android:layout_height="@dimen/flash_card_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_flash_card"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/quitButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Ä°lk sayÄ± widget'Ä± -->
    <TextView
        android:id="@+id/firstNumberText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/font_regular"
        android:padding="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="@id/blackboardImage"
        app:layout_constraintBottom_toBottomOf="@id/blackboardImage"
        app:layout_constraintStart_toStartOf="@id/blackboardImage"
        app:layout_constraintEnd_toStartOf="@id/secondNumberText"/>
    <TextView
        android:id="@+id/operator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_regular"
        android:textStyle="bold"
        android:textSize="40sp"
        android:textColor="@color/white"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="@id/firstNumberText2"
        app:layout_constraintEnd_toEndOf="@id/secondNumberText"
        app:layout_constraintBottom_toBottomOf="@id/blackboardImage"
        app:layout_constraintTop_toTopOf="@id/blackboardImage">

    </TextView>
    <!-- Ä°kinci sayÄ± widget'Ä± -->
    <TextView
        android:id="@+id/secondNumberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/font_regular"
        android:padding="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="@id/blackboardImage"
        app:layout_constraintBottom_toBottomOf="@id/blackboardImage"
        app:layout_constraintStart_toEndOf="@id/firstNumberText2"
        app:layout_constraintEnd_toEndOf="@id/blackboardImage"/>
    <!-- Ä°lk sayÄ± widget'Ä± -->
    <TextView
        android:id="@+id/firstNumberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/font_regular"
        android:padding="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="@id/blackboardImage"
        app:layout_constraintBottom_toBottomOf="@id/blackboardImage"
        app:layout_constraintStart_toStartOf="@id/blackboardImage"
        app:layout_constraintEnd_toEndOf="@id/blackboardImage"/>
    <EditText
        android:id="@+id/numberInput"
        android:layout_width="180dp"
        android:layout_height="98dp"
        android:background="@drawable/rounded_edittext"
        android:inputType="number"
        android:visibility="invisible"
        android:gravity="center"
        android:textSize="32sp"
        android:textColor="#222222"
        android:hint="?"
        android:padding="0dp"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/blackboardImage"
        app:layout_constraintBottom_toTopOf="@id/kontrolButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
