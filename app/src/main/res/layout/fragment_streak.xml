<?xml version="1.0" encoding="utf-8"?>
<!--
  Günlük seri ekranı — üst bardaki aleve dokununca açılır.

  Bugünün ilerleme çubuğu, uygulamanın diğer çubuklarıyla aynı çizimleri kullanıyor
  (daily_question_progress_*): görevler, günlük soru ve kupa yolu da aynı yerden besleniyor,
  dördüncü bir çubuk dili eklemenin anlamı yok.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnStreakBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Günlük Seri"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/streakLottie"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="fire_anim.json"
                app:lottie_loop="true" />

            <ImageView
                android:id="@+id/streakDeadIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:alpha="0.45"
                android:contentDescription="@null"
                android:src="@drawable/streak_flame_ic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/streakBigNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FF9800"
                android:textSize="52sp"
                android:textStyle="bold"
                tools:text="3" />

            <TextView
                android:id="@+id/streakBigLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="gün üst üste" />

            <TextView
                android:id="@+id/streakBigSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#93A5B3"
                android:textSize="14sp"
                tools:text="Bugün 3 dakika daha çalış, serin devam etsin." />

            <!-- Bugün -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_streak_option"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bugün"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/streakTodayZone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/daily_question_progress_height"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/daily_question_progress_track"
                        android:contentDescription="@null" />

                    <View
                        android:id="@+id/streakTodayFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="@null" />

                    <View
                        android:id="@+id/streakTodayShine"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/mission_progress_shine_height"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="@dimen/mission_progress_shine_inset_start"
                        android:layout_marginTop="@dimen/mission_progress_shine_top"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/streakTodayText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:outlineProvider="none"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2 / 5 dakika" />

                </FrameLayout>

            </LinearLayout>

            <!-- Hafta -->
            <LinearLayout
                android:id="@+id/streakWeekStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_streak_option"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="14dp" />

            <!-- Meydan okuma -->
            <LinearLayout
                android:id="@+id/streakChallengeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_streak_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/streak_flame_ic" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/streakChallengeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="3 Günlük Meydan Okuma" />

                    <TextView
                        android:id="@+id/streakChallengeSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#93A5B3"
                        android:textSize="13sp"
                        tools:text="3 GÜNÜN 1. GÜNÜ" />

                </LinearLayout>

            </LinearLayout>

            <!-- En uzun seri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_streak_option"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="En uzun serin"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/streakLongest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF9800"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="7 gün" />

            </LinearLayout>

            <Button
                android:id="@+id/streakChangeGoal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_streak_option"
                android:text="Günlük hedefi değiştir"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
