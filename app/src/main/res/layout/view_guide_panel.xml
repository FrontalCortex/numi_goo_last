<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guidePanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/guide_panel_background"
        android:clickable="false"
        android:focusable="false"
        android:elevation="15dp"
        android:padding="10dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/stepDotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sobi: rehber sayfasının hâlini oynatıyor (öğretmen resimlerinin yerine) -->
        <com.example.app.BunnyMascotView
            android:id="@+id/guideMascot"
            android:layout_width="@dimen/guide_mascot_size"
            android:layout_height="@dimen/guide_mascot_size"
            android:layout_marginStart="@dimen/abacus_fragment_guide_image_margin_start"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/stepDotsContainer"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvGuideText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="visible"
            android:text="Test Text"
            android:elevation="15dp"
            app:layout_constraintTop_toTopOf="@id/guideMascot"
            app:layout_constraintBottom_toBottomOf="@id/guideMascot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideMascot"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        app:layout_constraintStart_toStartOf="@id/panelContent"
        app:layout_constraintBottom_toBottomOf="@id/panelContent"
        android:id="@+id/btnBack"
        android:layout_width="@dimen/abacus_fragment_back_btn_size"
        android:layout_height="@dimen/abacus_fragment_back_btn_size"
        android:minWidth="@dimen/abacus_fragment_back_btn_min"
        android:minHeight="@dimen/abacus_fragment_back_btn_min"
        android:scaleType="fitCenter"
        android:layout_gravity="start|bottom"
        android:src="@drawable/back_circle_button"
        android:paddingLeft="@dimen/abacus_fragment_back_btn_padding"
        android:paddingBottom="@dimen/abacus_fragment_back_btn_padding"
        android:background="@null"
        android:elevation="20dp"
        android:contentDescription="Geri" />

    <ImageButton
        android:id="@+id/btnForward"
        android:layout_width="@dimen/abacus_fragment_back_btn_size"
        android:layout_height="@dimen/abacus_fragment_back_btn_size"
        android:minWidth="@dimen/abacus_fragment_back_btn_min"
        android:minHeight="@dimen/abacus_fragment_back_btn_min"
        android:scaleType="fitCenter"
        android:layout_gravity="start|bottom"
        android:background="@null"
        android:contentDescription="İleri"
        android:elevation="20dp"
        android:paddingBottom="@dimen/abacus_fragment_back_btn_padding"
        android:paddingLeft="@dimen/abacus_fragment_back_btn_padding"
        android:rotationY="180"
        android:src="@drawable/back_circle_button"
        app:layout_constraintBottom_toBottomOf="@id/panelContent"
        app:layout_constraintEnd_toEndOf="@id/panelContent" />

</androidx.constraintlayout.widget.ConstraintLayout>
