<?xml version="1.0" encoding="utf-8"?>
<!--
  Ders dönüşünde çıkan yeni seri ekranı (bkz. NewStreakFragment).

  Kayıt akışındaki seri adımlarıyla AYNI yapı: alevli tavşan, başlık, seçenek satırları ve
  altta tek düğme. İki ekranın farklı görünmesi, aynı sözün iki ayrı şey olduğu izlenimi
  verirdi — oysa ikisi de "kaç gün üst üste".

  Maskot elinde serinin alevini tutuyor (BunnyMascotView, FLAME); seçilen gün arttıkça alev
  büyüyor ve tavşan seviniyor (NewStreakFragment.renderOptions).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true">

    <com.example.app.BunnyMascotView
        android:id="@+id/newStreakMascot"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/newStreakTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/dark_text"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/newStreakMascot"
        tools:text="Şimdi bir öğrenme alışkanlığı kazanmana yardım edelim." />

    <TextView
        android:id="@+id/newStreakSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:textColor="#93A5B3"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/newStreakTitle"
        tools:text="Günde 5 dakika. Bu seçim sonradan değişmiyor."
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/newStreakOptions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/newStreakSubtitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newStreakContinue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="24dp"
        android:text="Devam et"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/dark_primary"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
