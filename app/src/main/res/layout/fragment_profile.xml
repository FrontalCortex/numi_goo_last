<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical">

    <!-- Başkasının profiline bakılırken görünen üst panel (fragment_followers_following'teki toolbar ile aynı) -->
    <LinearLayout
        android:id="@+id/otherUserProfileTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnOtherUserProfileBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvOtherUserProfileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_color"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Üst Alan - Kullanıcı Bilgileri -->
        <androidx.cardview.widget.CardView
            android:id="@+id/profileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:cardBackgroundColor="@color/background_color">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                <!-- Profil Fotoğrafı (Avatar) -->
                <ImageView
                    android:id="@+id/imgProfilePhoto"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/non_user"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Profil Fotoğrafı" />

                <!-- Kullanıcı Adı ve Katılım Tarihi -->
                <TextView
                    android:id="@+id/tvUsernameAndDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\@BAAR461745 • 2022 YILINDA KATILDI"
                    android:textColor="#93A5B3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- İstatistikler (Takip edilen, Takipçi) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Takip edilen -->
                    <LinearLayout
                        android:id="@+id/followingCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFollowingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Takip edilen"
                            android:textColor="#93A5B3"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Takipçi -->
                    <LinearLayout
                        android:id="@+id/followersCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFollowersCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Takipçi"
                            android:textColor="#93A5B3"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Arkadaş Ekle Butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFriend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="ARKADAŞ EKLE"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_person_add"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white"
                    app:backgroundTint="#131F24"
                    app:strokeColor="#37464F"
                    app:strokeWidth="2dp"
                    app:cornerRadius="12dp"
                    android:paddingVertical="12dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTopLeftName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:text="Kullanıcı Adı"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAccountSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ayarlar"
                    android:padding="8dp"
                    android:src="@drawable/setting_ic"
                    android:tint="@color/white" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Hesap / Aktivite Bilgileri -->
        <androidx.cardview.widget.CardView
            android:id="@+id/userAdvanceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:cardBackgroundColor="@color/background_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Sol: Kullanıcı İlerlemesi -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUserProgressTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="Kullanıcı İlerlemesi"
                            android:textColor="#93A5B3"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompletedLessons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            app:drawableStartCompat="@drawable/profile_book_ic3"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            app:drawableStartCompat="@drawable/profile_clock_ic2"
                            android:drawablePadding="8dp"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSubscriptionInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            app:drawableStartCompat="@drawable/profile_crown_ic4"
                            android:drawablePadding="8dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Sağ: Kullanıcı Abaküsü önizlemesi (rastgele bir boncuk kartı) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="Kullanıcı Abaküsü"
                            android:textColor="#93A5B3"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/abacusPreviewCard"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#1A262B"
                            app:cardCornerRadius="12dp">

                            <ImageView
                                android:id="@+id/abacusPreviewCardImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:scaleType="fitCenter"
                                android:contentDescription="@null" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:text="Kupa yolu"
                    android:textColor="#93A5B3"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:id="@+id/cupCards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/cupCard1"
                            layout="@layout/item_profile_cup_card" />

                        <include
                            android:id="@+id/cupCard2"
                            layout="@layout/item_profile_cup_card" />

                        <include
                            android:id="@+id/cupCard3"
                            layout="@layout/item_profile_cup_card" />

                        <include
                            android:id="@+id/cupCard4"
                            layout="@layout/item_profile_cup_card" />

                        <include
                            android:id="@+id/cupCard5"
                            layout="@layout/item_profile_cup_card" />

                        <include
                            android:id="@+id/cupCard6"
                            layout="@layout/item_profile_cup_card" />
                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/profileBadgesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/background_color"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProfileBadgesTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rozetler"
                        android:textColor="#93A5B3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnProfileBadgesArrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@null"
                        android:contentDescription="Rozetler"
                        android:padding="5dp"
                        android:src="@drawable/dualingo_arrow_ic"
                        app:tint="#93A5B3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/badgeItemDart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeDartBase"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                app:lottie_autoPlay="false"
                                android:layout_gravity="center"
                                app:lottie_loop="false" />

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeDartTop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />
                        </FrameLayout>

                        <com.example.app.BadgeRewardTextView
                            android:id="@+id/badgeDartValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-25dp"
                            android:text="50"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badgeItemRocket"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeRocketBase"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="center"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeRocketTop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />
                        </FrameLayout>

                        <com.example.app.BadgeRewardTextView
                            android:id="@+id/badgeRocketValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-25dp"
                            android:text="100"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badgeItemBowling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeBowlingBase"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="center"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeBowlingTop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_badge_circle_frame"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />
                        </FrameLayout>

                        <com.example.app.BadgeRewardTextView
                            android:id="@+id/badgeBowlingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-25dp"
                            android:text="150"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badgeItemGolf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeGolfBase"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="center"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/badgeGolfTop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false" />
                        </FrameLayout>

                        <com.example.app.BadgeRewardTextView
                            android:id="@+id/badgeGolfValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-25dp"
                            android:text="225"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
    </ScrollView>

</LinearLayout>
