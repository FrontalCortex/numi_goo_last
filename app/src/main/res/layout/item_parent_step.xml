<?xml version="1.0" encoding="utf-8"?>
<!-- Açılmış bir dersin tek adımı. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="26dp"
    android:paddingEnd="4dp">

    <View
        android:id="@+id/stepDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/parent_step_dot" />

    <TextView
        android:id="@+id/stepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/parent_text_primary"
        android:textSize="15sp"
        tools:text="Adım 1" />

    <TextView
        android:id="@+id/stepDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="end"
        android:textSize="15sp"
        tools:text="İlk denemede geçti" />
</LinearLayout>
