<?xml version="1.0" encoding="utf-8"?>
<!-- Veli panelinin en üstündeki özet kartı. Tek satır: neyi ne kadar yaptı. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/parent_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summaryFinishedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/parent_step_passed"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biten ders"
                android:textColor="@color/parent_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summaryTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/parent_text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="3s 20dk" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bugün"
                android:textColor="@color/parent_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summaryStreakValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lesson_header_orange"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Günlük seri"
                android:textColor="@color/parent_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/summaryNoteDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/parent_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Son 7 gün"
        android:textColor="@color/parent_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/summaryWeekStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/summaryNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/parent_text_muted"
        android:textSize="14sp"
        tools:text="Müfredatta 96 dersten 24'ü tamamlandı. En çok zorlandığı ders: Küçük Dost 4." />
</LinearLayout>
