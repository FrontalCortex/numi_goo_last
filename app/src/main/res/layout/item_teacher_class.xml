<?xml version="1.0" encoding="utf-8"?>
<!--
  Sınıflarım listesinde bir sınıf: sol ikon, ad, altında öğrencilerin avatarları üst üste
  (en fazla 4, fazlası "+N"). Katılma kodu sınıf ekranının ayarlarında. Göçen kart: bg_depth_card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_depth_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/classIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/class_board" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/className"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dark_text"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Cumartesi 10:00" />

        <!-- Avatarlar koddan ekleniyor (TeacherClassesFragment.bindFaces) -->
        <LinearLayout
            android:id="@+id/classFaces"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/classMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Henüz öğrenci yok" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/dualingo_arrow_ic"
        app:tint="@color/dark_text_secondary" />
</LinearLayout>
