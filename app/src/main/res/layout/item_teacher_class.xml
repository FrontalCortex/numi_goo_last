<?xml version="1.0" encoding="utf-8"?>
<!-- Sınıflarım listesinde bir sınıf: ad, öğrenci sayısı, katılma kodu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/hint_background"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/className"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dark_text"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Cumartesi 10:00" />

        <TextView
            android:id="@+id/classMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp"
            tools:text="12 öğrenci · Kod: ABC 234" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/dark_text_secondary" />
</LinearLayout>
