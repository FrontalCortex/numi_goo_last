<?xml version="1.0" encoding="utf-8"?>
<!--
  Seri ekranındaki seçim penceresi: günlük hedef ve meydan okuma aynı pencereyi kullanıyor.

  Satırlar XML'de değil [StreakViews.buildOptionRows] ile üretiliyor — kurulum akışındaki
  satırların aynısı olsunlar diye.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_streak_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/streakOptionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streakOptionsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#93A5B3"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/streakOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

</LinearLayout>
