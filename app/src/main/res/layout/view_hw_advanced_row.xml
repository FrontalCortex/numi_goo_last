<?xml version="1.0" encoding="utf-8"?>
<!--
  Ödev formunda "Gelişmiş" satırı: Konu kartının (toplama/çıkarma) ve Ayarlar kartının (çarpma)
  altında. Dokununca hangi rakamların gelebileceği paneli açılıyor; sağda o anki seçimin özeti
  (bkz. HomeworkCreateFragment.showAdvancedSheet).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_hw_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hw_advanced"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/advancedSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/dark_text_secondary"
        android:textSize="13sp"
        tools:text="5'lik: 3, 4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:includeFontPadding="false"
        android:text="›"
        android:textColor="@color/dark_text_secondary"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
