<?xml version="1.0" encoding="utf-8"?>
<!--
  Kök FrameLayout: sağ altta Sobi'nin testi düğmesi (MapSobiTestButton, PartSelectionFragment ekliyor)
  kaydırılan kartların üstünde sabit dursun diye.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/partSelectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="88dp">
        <!-- Alt boşluk 88dp = Sobi düğmesi (56dp) + üstünde/altında 16dp: son kartlar düğmenin
             altından kaydırılıp çıkarılabilsin. -->

        <!-- Toplama -->
        <TextView
            android:id="@+id/categoryTitleAddition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_part_selection_category_title_addition"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/additionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="28dp" />

        <!-- Cikarma -->
        <TextView
            android:id="@+id/categoryTitleSubtraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_part_selection_category_title_subtraction"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtractionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="28dp" />

        <!-- Carpma -->
        <TextView
            android:id="@+id/categoryTitleMultiplication"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_part_selection_category_title_multiplication"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/multiplicationRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="8dp" />

    </LinearLayout>
</ScrollView>

</FrameLayout>
