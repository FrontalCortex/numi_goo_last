<?xml version="1.0" encoding="utf-8"?>
<!--
  Kök FrameLayout: kayıt soruları ekranı 24dp dolgudan etkilenmesin diye içerik ayrı bir katmanda.

  Düzen (yukarıdan aşağı): öğretmen/öğrenci geçişi (sağ üst) → maskot animasyonu → başlık →
  motivasyon metni → "Başla" (yeni kullanıcı) → "Zaten hesabım var" (giriş).

  Eski düzende iki eşit soru vardı ("Hesabın mı var?" / "İlk defa mı giriyorsun?"). Yeni
  düzende ekran ilk kez gelen çocuğa konuşuyor: ana eylem kayıt, giriş ikincil bir bağlantı.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loginStartContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!--
          Öğretmen/öğrenci geçişi. Hedef kitlenin küçük bir kısmı için; sağ üstte, ana
          akışın yolunda durmadan bulunabilir. Dokunma alanı en az 48dp.
        -->
        <TextView
            android:id="@+id/btnTeacherMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:text="@string/login_start_teacher_mode_button"
            android:textColor="@color/dark_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/font_regular"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--
          Maskot (tavşan). Genişliğin %70'i, kare. Dokununca seviniyor.

          Tavşan + başlık + metin tek bir dikey zincir (packed), öğretmen düğmesiyle "Başla"
          arasında, bias 1: grup düğmenin hemen üstüne yaslanıyor. Böylece tavşan ekranın
          ortasına olabildiğince yakın duruyor ama metin hiçbir ekranda düğmeye binmiyor.
          Tavşan tam ortaya sabitlenseydi bu telefonda (393×873dp) metin düğmeye biniyordu,
          küçük ekranda ~70dp. Eskiden grup alta bağlı değildi ve yukarı yapışıyordu.
        -->
        <com.example.app.BunnyMascotView
            android:id="@+id/mascotView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@id/btnTeacherMode"
            app:layout_constraintBottom_toTopOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="1" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/login_start_student_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:gravity="center"
            android:fontFamily="@font/font_regular"
            app:layout_constraintTop_toBottomOf="@id/mascotView"
            app:layout_constraintBottom_toTopOf="@id/tvBody"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="48dp"
            android:text="@string/login_start_student_subtitle"
            android:textSize="17sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/dark_text_secondary"
            android:gravity="center"
            android:fontFamily="@font/font_regular"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintBottom_toTopOf="@id/btnStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ana eylem: kayıt akışı (UserInfoFragment). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/login_start_start_button"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/background_color"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/dark_primary"
            app:layout_constraintBottom_toTopOf="@id/btnLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- İkincil eylem: giriş. Düğme değil bağlantı görünümünde. -->
        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/login_start_login_button"
            android:textColor="@color/dark_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_regular"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      Kayıt soruları ekranı — kökteki 24dp dolgunun DIŞINDA.

      Eskiden dolgulu ConstraintLayout'un çocuğuydu ve adım ekranları kenarlardan boşluklu
      duruyordu. ConstraintLayout negatif kenar boşluğunu yok saydığı için tek doğru çözüm
      kabı dolgulu düzenin dışına almaktı.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/userInfoFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
