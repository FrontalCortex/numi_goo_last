<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_color"
    android:layout_gravity="center"
    android:paddingHorizontal="24dp"
    android:paddingTop="48dp">

    <!--
      Sobi: başarısız derste hep üzgün → kararlı. Başlık, açıklama, kutular ve düğme ekranın
      altında toplanıyor; Sobi üstte kalan bütün yeri kaplıyor (çizim kendini kareye
      sığdırıp ortalıyor).
    -->
    <com.example.app.BunnyMascotView
        android:id="@+id/mascotView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Başlık -->
    <TextView
        android:id="@+id/resultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ders Geçilemedi!"
        android:textColor="#E93939"
        android:textSize="28sp"
        android:textStyle="bold"
        />
    <TextView
        android:id="@+id/resultTitleComment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Başarı oranı %75'ten düşük!"
        android:textColor="#E00000"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <!-- Sonuç kutuları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp">

        <!-- Toplam Puan -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/result_box_yellow"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOPLAM PUAN"
                android:textColor="#FFD600"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/totalScore"
                android:text="25"
                android:textColor="#FFD600"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Başarı Oranı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/result_box_green"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAŞARI"
                android:textColor="#7ED321"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/successRate"
                android:text="90%"
                android:textColor="#7ED321"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Puanı Al Butonu -->
    <Button
        android:id="@+id/claimButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:fontFamily="@font/font_regular"
        android:text="Çıkış"
        android:layout_marginBottom="20dp"
        android:textStyle="bold"
        android:textColor="#101820"
        android:backgroundTint="#8CC63F"
        android:textSize="18sp"/>
</LinearLayout>