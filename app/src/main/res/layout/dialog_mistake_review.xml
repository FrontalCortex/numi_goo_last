            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Alt düğme: Kontrol Et (sonuç sayfasında Derse dön). Adımın gösterimi sohbetteki gri
         "Abaküste göster" seçeneğinde (eskiden burada "Bana göster" vardı; aynı işi gören iki düğme
         kafa karıştırıyordu, kullanıcı kararı 02.11.2026). -->
    <LinearLayout
        android:id="@+id/reviewButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/reviewCheck"
            android:layout_width="0dp"
            android:layout_height="@dimen/tutorial_control_button_height"
            android:layout_weight="1.4"
            android:background="@drawable/bg_depth_tutorial_control"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="@string/review_check"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
