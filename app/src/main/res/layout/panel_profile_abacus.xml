<?xml version="1.0" encoding="utf-8"?>
<!-- Profildeki "Kullanıcı Abaküsü" kartına tıklanınca açılan panel: kullanıcının gerçek boyutlu,
     sürüklenebilir abaküsü (AbacusCustomizationFragment'in önizlemesiyle aynı mekanizma). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_daily_question_continue"
    android:clipToOutline="true"
    android:padding="20dp">

    <ImageView
        android:id="@+id/profileAbacusPanelClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="@null"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="8dp"
        android:src="@drawable/ic_close_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <FrameLayout
        android:id="@+id/profileAbacusPanelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/profileAbacusPanelClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sadece kendi abaküsümüze bakarken görünür: profil kartında (fragment_profile.xml →
         abacusPreviewCardImage) gösterilecek boncuğu, sahip olunan boncuklar arasından seçmek için. -->
    <LinearLayout
        android:id="@+id/previewBeadSelectorRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/profileAbacusPanelContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Profil ikonunu değiştir"
            android:textColor="#93A5B3"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previewBeadPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@android:color/white" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/previewBeadCard"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp">

                <ImageView
                    android:id="@+id/previewBeadCardImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/previewBeadNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:scaleX="-1"
                android:src="@drawable/ic_back_arrow"
                app:tint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
