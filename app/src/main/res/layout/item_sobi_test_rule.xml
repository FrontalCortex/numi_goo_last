<?xml version="1.0" encoding="utf-8"?>
<!-- Sobi'nin testi panelinde bir kural: adı, "Seviye 5/20" ve seviye çubuğu (SobiTestSheet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_sobi_test_rule"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ruleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="10'luk toplama" />

        <TextView
            android:id="@+id/ruleLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1CB0F6"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Seviye 5/20" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/ruleLevelBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="20"
        app:indicatorColor="#1CB0F6"
        app:trackColor="#1AFFFFFF"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />
</LinearLayout>
