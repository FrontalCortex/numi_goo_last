<?xml version="1.0" encoding="utf-8"?>
<!--
  Ekran ÇIKIŞI: sola itilerek. [queue_screen_in] ile çift; kapsamı orada anlatılıyor.

  Süre ve eğri queue_screen_in ile BİREBİR aynı olmak zorunda. Farklı eğri kullanıldığında
  (giriş yavaşlayan, çıkış hızlanan) ikisi aynı anda farklı hızda hareket ediyor: gelen
  ekran ilk anda hızlı, giden ekran neredeyse duruyor, aralarındaki mesafe açılıyor ve
  gelen ekran gidenin üstüne biniyormuş gibi duruyor. Aynı eğriyle ikisi birbirine yapışık
  kalıyor ve tek bir itme hareketi okunuyor.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
    android:shareInterpolator="true">
    <translate
        android:duration="400"
        android:fromXDelta="0%"
        android:toXDelta="-100%" />
</set>
