<?xml version="1.0" encoding="utf-8"?>
<!--
  Ekran ÇIKIŞI: sola itilerek. [queue_screen_in] ile çift; kapsamı orada anlatılıyor.

  Süresi queue_screen_in ile aynı; eğri hızlanan, çünkü çıkan ekran sahneyi bırakıyor,
  giren ekran ise yavaşlayarak yerine oturuyor. İkisi birlikte tek bir itme hareketi
  okunuyor.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:shareInterpolator="true">
    <translate
        android:duration="300"
        android:fromXDelta="0%"
        android:toXDelta="-100%" />
</set>
