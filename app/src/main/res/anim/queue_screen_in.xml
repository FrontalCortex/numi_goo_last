<?xml version="1.0" encoding="utf-8"?>
<!--
  Ekran GİRİŞİ: sağdan kayarak.

  Adı ders sonrası kuyruğundan geliyor ama kapsamı artık daha geniş: ders akışındaki
  bütün ekranlar (tutorial, abaküs, körleme, soru paneli, sonuç, sandık, rozet) bu çifti
  kullanıyor. Kural tek cümle: her ekran SAĞDAN girer, SOLA çıkar.

  Neden ayrı bir çizim: paylaşılan slide_in_right 500 ms sürüyor, alpha ile soluyor ve
  çıkış çizimleri 300 ms. Giren ekran yavaşça belirirken çıkan hızla gidiyor, üstelik
  alpha yüzünden arkadaki zemin girişin ortasında görünüyordu — art arda gelen iki ekran
  tek bir akış gibi okunmuyordu. slide_in_right on ayrı yerde kullanıldığı için
  değiştirilmedi; kuyruk kendi çiftini kullanıyor.

  Süre ve eğri queue_screen_out ile eşleşmek ZORUNDA; sebebi orada anlatılıyor.
  400 ms: 300 ms'de geçiş okunamayacak kadar hızlı geliyordu.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
    android:shareInterpolator="true">
    <translate
        android:duration="400"
        android:fromXDelta="100%"
        android:toXDelta="0%" />
</set>
