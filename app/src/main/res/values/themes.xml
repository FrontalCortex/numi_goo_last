<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NumiGoo" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@color/background_color</item>
    </style>

    <!--
      Açılış (SplashActivity): koyu zeminde mor dairede Sobi — ana ekrandaki uygulama ikonunun aynısı.
      Mor daire resmin içinde (zeminsiz açılış ikonu, 288dp): MIUI ikon zemin rengini daireye
      kırpmadan kare çiziyordu, sonra bizim yuvarlak ikona geçiliyordu (10.11.2026).
      Sistem bunu ilk kare çizilene kadar gösteriyor; sonra SplashActivity aynı ikonu aynı yerden
      alıp altına "Sorobit" yazısını getiriyor (tek ekran gibi).
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NumiGoo</item>
    </style>

    <!--
      Açık kaynak lisansları ekranları (play-services-oss-licenses). Kütüphanenin varsayılanı açık
      renkli; uygulamanın koyu görünümü ve başlık çubuğu (geri tuşu) olsun diye.
    -->
    <style name="Theme.NumiGoo.Licenses" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/background_color</item>
        <item name="colorPrimaryDark">@color/background_color</item>
        <item name="colorAccent">@color/dark_primary</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@color/background_color</item>
    </style>

    <!-- Sistem dark/light temasından bağımsız, hep koyu arka plan kullanan tema -->
    <style name="Theme.NumiGoo" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@color/background_color</item>
        <!-- Koyu bar üzerinde açık ikonlar -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Uygulama genel arkaplanı -->
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/background_color</item>
        <!-- Font family -->
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
        <!-- Text style -->
        <item name="android:textStyle">bold</item>
        <!-- Default text appearances -->
        <item name="android:textViewStyle">@style/Widget.NumiGoo.TextView</item>
        <item name="buttonStyle">@style/Widget.NumiGoo.Button</item>
        <!-- Material3 BottomNavigation + Theme.MaterialComponents → M3 overlay attr çözülemez (inflate crash). Varsayılan kullan. -->
    </style>

    <!-- TextView için özel stil -->
    <style name="Widget.NumiGoo.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- BottomNavigationView etiket (h700 / varsayılan dimen ile ölçeklenir) -->
    <style name="TextAppearance.NumiGoo.BottomNav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/main_bottom_nav_text_size</item>
    </style>

    <!-- Button için özel stil -->
    <style name="Widget.NumiGoo.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="ShapeAppearanceOverlay_RecordAvatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Admin hata bildirimi inceleme ekranı: tam ekran diyalog, MaterialButton için uygulama teması üstünde. -->
    <style name="Theme.App.BugReportReview" parent="Theme.NumiGoo">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>