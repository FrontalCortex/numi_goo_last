<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FullScreenDialog" parent="Theme.AppCompat.Dialog">
    </style>
    <style name="DialogAnimationSlideLeft">
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>
    <style name="DialogAnimationSlideRight">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>
    <!--
      Ders sonrası kuyruğundaki dialog ekranları: AdSkipFragment, NewStreakFragment,
      AskQuestionOpenFragment. Fragment olarak eklenen kuyruk ekranları (sandık, rozet,
      görev ödülü) aynı çizimleri setCustomAnimations ile kullanıyor.

      Kural: her ekran SAĞDAN girer, SOLA çıkar. Yön ortak olmazsa çıkan ekranla giren
      ekran aynı kenarda çakışıyor ve akış ileri değil geri gidiyormuş gibi okunuyor.
      Süre ve eğri de ortak: biri 500 ms solarak diğeri 300 ms kayarak hareket ederse
      art arda gelen ekranlar tek bir akış gibi görünmüyor.
    -->
    <style name="QueueScreenAnimation">
        <item name="android:windowEnterAnimation">@anim/queue_screen_in</item>
        <item name="android:windowExitAnimation">@anim/queue_screen_out</item>
    </style>
</resources>